CREATE PROCEDURE [dbo].[sp_Claim_Outgoing_Document] @P__ModifiedBy NVARCHAR(255) = N'AlternaSystem'
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH candidate
    AS (SELECT TOP (1)
            *
        FROM dbo.t_Outgoing_Documents WITH (UPDLOCK, READPAST, READCOMMITTEDLOCK)
        WHERE (
                  PublicationState IN ( 'Pending', 'Failed' )
                  AND (
                          NextAttemptDate IS NULL
                          OR NextAttemptDate <= GETDATE()
                      )
              )
              OR (
                     PublicationState = 'Publishing'
                     AND PublicationStartedDate < DATEADD(minute, -2, GETDATE())
                 )
        ORDER BY CreatedDate,
                 Id
       )
    UPDATE candidate
    SET PublicationState = 'Publishing',
        PublicationStartedDate = GETDATE(),
        LastModifiedBy = @P__ModifiedBy,
        LastModifiedDate = GETDATE()
    OUTPUT inserted.Id;
END;
GO

