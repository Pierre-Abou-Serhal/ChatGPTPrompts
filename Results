Your stored procedure should still return one flat row per rule. Then C# combines those rows into one `AccessPolicy` object.

Do not use `TOP 1`, because that would return only one rule.

```text
Policy 1 + Rule 1
Policy 1 + Rule 2
Policy 1 + Rule 3
```

becomes one policy containing three rules.

Create a reusable mapper:

```csharp
private static AccessPolicy MapSingleAccessPolicy(
    IEnumerable<AccessPolicyDbRowDto> source)
{
    List<AccessPolicyDbRowDto> rows = source.ToList();

    if (rows.Count == 0)
    {
        throw new InvalidOperationException(
            "The stored procedure did not return an access policy.");
    }

    AccessPolicyDbRowDto firstRow = rows[0];

    if (rows.Any(row =>
            row.AccessPolicyId != firstRow.AccessPolicyId))
    {
        throw new InvalidOperationException(
            "The stored procedure returned more than one access policy.");
    }

    return new AccessPolicy
    {
        Id = firstRow.AccessPolicyId,
        PolicyCode = firstRow.AccessPolicyCode,
        PolicyName = firstRow.AccessPolicyName,
        IsEnabled = firstRow.IsAccessPolicyEnabled,
        CreatedDate = firstRow.AccessPolicyCreatedDate,
        CreatedBy = firstRow.AccessPolicyCreatedBy,
        LastModifiedDate =
            firstRow.AccessPolicyLastModifiedDate,
        LastModifiedBy =
            firstRow.AccessPolicyLastModifiedBy,

        AccessPolicyRules = rows
            .Select(row => new AccessPolicyRule
            {
                Id = row.AccessPolicyRuleId,
                AccessPolicyId =
                    row.AccessPolicyRuleAccessPolicyId,
                RuleName =
                    row.AccessPolicyRuleName,
                WindowSeconds =
                    row.AccessPolicyRuleWindowSeconds,
                MaximumAccessCount =
                    row.AccessPolicyRuleMaximumAccessCount,
                IsEnabled =
                    row.IsAccessPolicyRuleEnabled,
                CreatedDate =
                    row.AccessPolicyRuleCreatedDate,
                CreatedBy =
                    row.AccessPolicyRuleCreatedBy,
                LastModifiedDate =
                    row.AccessPolicyRuleLastModifiedDate,
                LastModifiedBy =
                    row.AccessPolicyRuleLastModifiedBy
            })
            .OrderBy(rule => rule.Id)
            .ToList()
    };
}
```

Then use it in your update method:

```csharp
public async Task<AccessPolicy> UpdateAccessPolicy(
    UpdateAccessPolicyRequest request)
{
    DapperDal dal =
        new DapperDal(_globalSettings.ConnString);

    DynamicParameters parameters = new();

    // Add your policy and TVP parameters here.
    parameters.Add(
        "P__PolicyId",
        request.PolicyId);

    parameters.Add(
        "P__PolicyCode",
        request.PolicyCode);

    parameters.Add(
        "P__PolicyName",
        request.PolicyName);

    parameters.Add(
        "P__IsEnabled",
        request.IsEnabled);

    parameters.Add(
        "P__User",
        request.User);

    parameters.Add(
        "P__Error",
        dbType: DbType.String,
        direction: ParameterDirection.Output,
        size: 4000);

    IEnumerable<AccessPolicyDbRowDto> result =
        await dal.ExecuteQueryAsync<AccessPolicyDbRowDto>(
            "usp_UpdateAccessPolicy",
            parameters,
            CommandType.StoredProcedure,
            DapperDal.CommandDirection.Update);

    String? storedProcedureError =
        parameters.Get<String>("P__Error");

    if (!String.IsNullOrWhiteSpace(storedProcedureError))
    {
        throw new SGBLBadRequestException(
            storedProcedureError);
    }

    return MapSingleAccessPolicy(result);
}
```

Your final SQL query should continue using:

```sql
WHERE AP.Id = @P__PolicyId
```

and joining the rules:

```sql
FROM dbo.t_AccessPolicy AS AP
INNER JOIN dbo.t_AccessPolicyRule AS APR
    ON APR.AccessPolicyId = AP.Id
WHERE AP.Id = @P__PolicyId
ORDER BY APR.Id;
```

SQL returns multiple physical rows, but they all represent one policy. Your C# method returns one `AccessPolicy` model with its complete `AccessPolicyRules` collection.
