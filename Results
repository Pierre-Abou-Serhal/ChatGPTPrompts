CREATE PROCEDURE [dbo].[sp_Get_Batch] @P__Id BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT b.Id,
           b.ReceiptId,
           i.Code AS Institution,
           b.InputCode,
           b.OutputCode,
           b.MappingRevision,
           b.OriginalMessageId,
           b.OriginalCreation,
           b.State,
           b.CurrentRevision,
           b.AssignmentLockedDate,
           b.CreatedDate,
           (
               SELECT COUNT(*) FROM dbo.t_Transfers t WHERE t.BatchId = b.Id
           ) AS TransferCount,
           (
               SELECT COUNT(*)
               FROM dbo.t_Transfers t
               WHERE t.BatchId = b.Id
                     AND t.Decision = 'Pending'
           ) AS PendingCount,
           (
               SELECT COUNT(*)
               FROM dbo.t_Transfers t
               WHERE t.BatchId = b.Id
                     AND t.Decision = 'Rejected'
                     AND t.DecisionSource = 'System'
           ) AS SystemRejectedCount,
           (
               SELECT COUNT(*)
               FROM dbo.t_Transfers t
               WHERE t.BatchId = b.Id
                     AND t.Decision = 'Rejected'
                     AND t.DecisionSource = 'Operator'
           ) AS OperatorRejectedCount
    FROM dbo.t_Payment_Batches b
        JOIN dbo.t_Institutions i
            ON i.Id = b.EffectiveInstitutionId
    WHERE b.Id = @P__Id;
END;
GO

