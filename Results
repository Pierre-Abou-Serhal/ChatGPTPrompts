public async Task<List<ChangeAuditDto>> GetAccessPolicyAudit(
    GetAccessPolicyAuditRequest request)
{
    if (request.AccessPolicyId is <= 0)
        throw new SGBLBadRequestException("AccessPolicyId must be greater than zero.");

    if (request.PageNumber < 1)
        throw new SGBLBadRequestException("PageNumber must be greater than zero.");

    if (request.PageSize is < 1 or > 100)
        throw new SGBLBadRequestException("PageSize must be between 1 and 100.");

    DynamicParameters parameters = new();
    parameters.Add("@P__AccessPolicyId", request.AccessPolicyId, DbType.Int64);
    parameters.Add("@P__PageNumber", request.PageNumber, DbType.Int32);
    parameters.Add("@P__PageSize", request.PageSize, DbType.Int32);

    // Retains the DAL/transaction ownership pattern supplied in your code.
    DapperDal dal = new DapperDal(_globalSettings.ConnString);

    IEnumerable<ChangeAudit> rows = await dal.ExecuteQueryAsync<ChangeAudit>(
        "dbo.usp_GetAccessPolicyAudit",
        parameters,
        CommandType.StoredProcedure,
        DapperDal.CommandDirection.Select);

    return ChangeAuditMapper.ToDtos(rows);
}
