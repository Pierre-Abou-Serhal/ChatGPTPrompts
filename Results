CREATE PROCEDURE [dbo].[usp_GetDocumentReference]
    @P__CustomerId NVARCHAR(255) = NULL,
    @P__ExternalId NVARCHAR(255) = NULL,
	@P__AccountNumber NVARCHAR(255) = NULL,
	@P__DocumentCuk NVARCHAR(255) = NULL,
	@P__PageNumber INT = 1,
    @P__PageSize INT = 10,
    @P__TotalRecords INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    
	SELECT @P__TotalRecords = COUNT(*) 
    FROM [dbo].[t_DocumentReference];

	SELECT 
		DR.[Id],
		DR.[CustomerId],
		DR.[ExternalId],
		DR.[AccessPolicyId],
		AP.[PolicyName],
		DR.[AccountNumber],
		DR.[DocumentCuk],
		DR.[TokenHash],
		DR.[ExpiredDate],
		DR.[RevokedDate],
		DR.[RevokedBy],
		DR.[RevokedReason],
		DR.[IsActive],
		DR.[CreatedDate],
		DR.[CreatedBy],
		DR.[LastModifiedDate],
		DR.[LastModifiedBy]
	FROM [dbo].[t_DocumentReference] AS DR
	JOIN t_AccessPolicy AS AP ON DR.AccessPolicyId = AP.Id
	WHERE
		(@P__CustomerId IS NULL OR DR.[CustomerId] = @P__CustomerId)
		AND (@P__ExternalId IS NULL OR DR.[ExternalId] = @P__ExternalId)
		AND (@P__AccountNumber IS NULL OR DR.[AccessPolicyId] = @P__AccountNumber)
		AND (@P__DocumentCuk IS NULL OR DR.[DocumentCuk] = @P__DocumentCuk)
	ORDER BY CreatedDate DESC
	OFFSET (@P__PageNumber - 1) * @P__PageSize ROWS
    FETCH NEXT @P__PageSize ROWS ONLY;
END

