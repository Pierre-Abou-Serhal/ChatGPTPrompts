public async Task<List<DocumentAccessAudit>> GetDocumentAccessAudit(
    GetDocumentAccessAuditRequest request)
{
    DapperDal dal = new DapperDal(_globalSettings.ConnString);
    DynamicParameters parameters = new();
    parameters.Add("P__DocumentReferenceId", request.DocumentReferenceId, DbType.Int64);

    IEnumerable<DocumentAccessAuditDbRow> rows =
        await dal.ExecuteQueryAsync<DocumentAccessAuditDbRow>(
            "dbo.usp_GetDocumentAccessAudit",
            parameters,
            CommandType.StoredProcedure,
            DapperDal.CommandDirection.Select);

    return DocumentAccessAuditMapper.ToModels(rows);
}
