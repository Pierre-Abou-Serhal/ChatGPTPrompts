using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;

// Add your existing model/DTO namespaces if they differ from this file's.
public static class ChangeAuditMapper
{
    public static List<ChangeAuditDto> ToDtos(IEnumerable<ChangeAudit> rows)
    {
        ArgumentNullException.ThrowIfNull(rows);

        return rows
            .GroupBy(row => row.ChangeSetId)
            .OrderByDescending(save => save.Max(row => row.ChangedDate))
            .ThenByDescending(save => save.Max(row => row.ChangeAuditId))
            .Select(save =>
            {
                ChangeAudit first = save.OrderBy(row => row.ChangeAuditId).First();

                List<ChangeAuditEntityDto> entities = save
                    .GroupBy(row => row.ChangeAuditId)
                    .OrderBy(entity => EntityOrder(entity.First().EntityName))
                    .ThenBy(entity => entity.Key)
                    .Select(entity =>
                    {
                        ChangeAudit header = entity.First();

                        return new ChangeAuditEntityDto
                        {
                            ChangeAuditId = header.ChangeAuditId,
                            EntityName = header.EntityName,
                            EntityKey = header.EntityKey,
                            // Uses the historical label, not today's live name.
                            EntityLabel = header.EntityDisplayName,
                            EntityTypeLabel = EntityLabel(header.EntityName),
                            Action = header.Action,
                            ActionLabel = ActionLabel(header.Action),
                            Changes = entity
                                .OrderBy(field => field.ChangeAuditDetailId)
                                .Select(field => new ChangeAuditFieldDto
                                {
                                    FieldName = field.FieldName,
                                    FieldLabel = FieldLabel(field),
                                    ValueType = ValueType(field),
                                    OldValue = field.OldValue,
                                    NewValue = field.NewValue,
                                    OldDisplayValue = DisplayValue(field, field.OldValue, isOld: true),
                                    NewDisplayValue = DisplayValue(field, field.NewValue, isOld: false)
                                }).ToList()
                        };
                    }).ToList();

                return new ChangeAuditDto
                {
                    ChangeSetId = save.Key,
                    // SQL DATETIME2 has no timezone. Our audit writer stores UTC.
                    ChangedDate = new DateTimeOffset(DateTime.SpecifyKind(
                        save.Max(row => row.ChangedDate), DateTimeKind.Utc)),
                    ChangedBy = first.ChangedBy,
                    Summary = BuildSummary(first.ChangedBy, entities),
                    Entities = entities
                };
            }).ToList();
    }

    private static string BuildSummary(string user, List<ChangeAuditEntityDto> entities)
    {
        if (entities.Count == 1)
        {
            ChangeAuditEntityDto entity = entities[0];
            return $"{user} {entity.ActionLabel.ToLowerInvariant()} {entity.EntityTypeLabel.ToLowerInvariant()} \"{entity.EntityLabel}\".";
        }

        return $"{user} saved changes to {entities.Count} items.";
    }

    private static int EntityOrder(string entityName) => entityName switch
    {
        "AccessPolicy" => 0,
        "AccessPolicyRule" => 1,
        "Config" => 2,
        _ => 3
    };

    private static string EntityLabel(string entityName) => entityName switch
    {
        "AccessPolicy" => "Access policy",
        "AccessPolicyRule" => "Access rule",
        "Config" => "Configuration setting",
        _ => "Item"
    };

    private static string ActionLabel(string action) => action switch
    {
        "INSERT" => "Created",
        "UPDATE" => "Updated",
        "DELETE" => "Deleted",
        _ => "Changed"
    };

    private static string FieldLabel(ChangeAudit row) => (row.EntityName, row.FieldName) switch
    {
        ("AccessPolicyRule", "WindowSeconds") => "Time window",
        _ => string.IsNullOrWhiteSpace(row.FieldDisplayName)
            ? row.FieldName : row.FieldDisplayName
    };

    private static string ValueType(ChangeAudit row) => (row.EntityName, row.FieldName) switch
    {
        ("AccessPolicy", "IsEnabled") or ("AccessPolicyRule", "IsEnabled") => "boolean",
        ("AccessPolicyRule", "WindowSeconds") => "duration",
        ("AccessPolicyRule", "MaximumAccessCount") => "integer",
        ("AccessPolicyRule", "AccessPolicyId") => "identifier",
        _ => "text"
    };

    private static string DisplayValue(ChangeAudit row, string? value, bool isOld)
    {
        // Missing sides of creation/deletion are not real NULL field values.
        if ((isOld && row.Action == "INSERT") || (!isOld && row.Action == "DELETE"))
            return "Not applicable";

        if (value is null)
            return row.EntityName == "AccessPolicyRule" && row.FieldName == "WindowSeconds"
                ? "Document lifetime" : "Not provided";

        if (value.Length == 0)
            return "Empty";

        if (string.IsNullOrWhiteSpace(value))
            return $"Whitespace ({value.Length} characters)";

        if (ValueType(row) == "boolean")
        {
            if (value == "1" || string.Equals(value, "true", StringComparison.OrdinalIgnoreCase))
                return "Enabled";
            if (value == "0" || string.Equals(value, "false", StringComparison.OrdinalIgnoreCase))
                return "Disabled";
        }

        if (ValueType(row) == "duration" && int.TryParse(
                value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int seconds)
            && seconds > 0)
            return FormatDuration(seconds);

        // Unknown fields and config setting values retain their exact text.
        // Never interpret a Config.SettingValue as seconds or a boolean merely
        // because its content happens to look like one.
        return value;
    }

    private static string FormatDuration(int seconds)
    {
        List<string> parts = [];
        AddDurationPart(parts, seconds / 86400, "day");
        seconds %= 86400;
        AddDurationPart(parts, seconds / 3600, "hour");
        seconds %= 3600;
        AddDurationPart(parts, seconds / 60, "minute");
        AddDurationPart(parts, seconds % 60, "second");
        return string.Join(" ", parts);
    }

    private static void AddDurationPart(List<string> parts, int value, string unit)
    {
        if (value > 0)
            parts.Add($"{value.ToString(CultureInfo.InvariantCulture)} {unit}{(value == 1 ? "" : "s")}");
    }
}
