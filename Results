git ls-files --modified -z |
while IFS= read -r -d '' file; do
    [ -f "$file" ] && [ ! -L "$file" ] || continue

    indexed=$(git rev-parse --verify ":$file") || continue
    current=$(git hash-object --path="$file" -- "$file") || continue

    if [ "$indexed" = "$current" ]; then
        git -c core.fileMode=false --literal-pathspecs add -- "$file" || break
        printf 'Refreshed: %s\n' "$file"
    fi
done

git status --short
