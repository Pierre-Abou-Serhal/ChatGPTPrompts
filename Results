ALTER PROCEDURE [dbo].[usp_UpdateTransfer]
    @P__TransferReference NVARCHAR(255),
    @P__SenderCustomerId NVARCHAR(255) = NULL,
    @P__SenderExternalId NVARCHAR(255) = NULL,
    @P__SenderLoginCustomerId NVARCHAR(255) = NULL,
    @P__SenderDebitAccount NVARCHAR(255) = NULL,
    @P__SenderDebitCommission DECIMAL(18, 4) = NULL,
    @P__SenderFirstName NVARCHAR(255) = NULL,
    @P__SenderMiddleName NVARCHAR(255) = NULL,
    @P__SenderLastName NVARCHAR(255) = NULL,
    @P__SenderMobileNumber NVARCHAR(255) = NULL,
    @P__InternalAccountNumber NVARCHAR(255) = NULL,
    @P__ReceiverCustomerId NVARCHAR(255) = NULL,
    @P__ReceiverExternalId NVARCHAR(255) = NULL,
    @P__ReceiverFirstName NVARCHAR(255) = NULL,
    @P__ReceiverMiddleName NVARCHAR(255) = NULL,
    @P__ReceiverLastName NVARCHAR(255) = NULL,
    @P__ReceiverMobileNumber NVARCHAR(255) = NULL,
    @P__ReceiverCreditAccountNumber NVARCHAR(255) = NULL,
    @P__SentTransferFt NVARCHAR(255) = NULL,
    @P__ReceivedTransferFt NVARCHAR(255) = NULL,
    @P__ReversalTransferFt NVARCHAR(255) = NULL,
    @P__ReversalReason NVARCHAR(255) = NULL,
    @P__TransferCurrency NVARCHAR(255) = NULL,
    @P__TransferAmount DECIMAL(18, 4) = NULL,
    @P__TransferExpiryHours INT,
    @P__Status NVARCHAR(255),
    @P__Notes NVARCHAR(4000) = NULL,
    @P__Error NVARCHAR(4000) OUTPUT,
    -- ADDED: Set to 1 only for the first processTransfer update before T24.
    @P__IsInitialAction BIT = 0
AS
BEGIN
    SET NOCOUNT ON;
    SET @P__Error = NULL;

    -- ADDED START: Validate/reserve an initial processing action atomically.
    -- This is used for APPROVE/REJECT/CANCEL/EXPIRED processing, not creation.
    -- P__Status contains the mapped database status, e.g. ACCEPTED for APPROVE.
    IF @P__IsInitialAction = 1
    BEGIN
        IF @P__Status IS NULL
           OR @P__Status NOT IN ('ACCEPTED', 'CANCELLED', 'REJECTED', 'EXPIRED')
        BEGIN
            SET @P__Error = 'Invalid transfer action.';
            RETURN;
        END;

        IF @P__TransferExpiryHours IS NULL
           OR @P__TransferExpiryHours <= 0
        BEGIN
            SET @P__Error = 'Invalid transfer expiry hours.';
            RETURN;
        END;

        DECLARE @ActionDate DATETIME = GETDATE();

        UPDATE dbo.t_Transfer
        SET
            [Status] =
                CASE
                    WHEN @ActionDate >= DATEADD(
                        HOUR, @P__TransferExpiryHours, CreatedDate
                    )
                    THEN 'EXPIRED'
                    ELSE @P__Status
                END,
            ReversalReason =
                CASE
                    WHEN @ActionDate >= DATEADD(
                        HOUR, @P__TransferExpiryHours, CreatedDate
                    )
                    THEN 'Expired'
                    ELSE COALESCE(NULLIF(@P__ReversalReason, ''), ReversalReason)
                END,
            Notes = COALESCE(@P__Notes, Notes),
            LastModifiedDate = @ActionDate
        OUTPUT INSERTED.*
        WHERE
            TransferReference = @P__TransferReference
            -- Sender posting must have completed before an action can start.
            AND NULLIF(LTRIM(RTRIM(SentTransferFt)), '') IS NOT NULL
            AND
            (
                (
                    [Status] = 'PENDING'
                    AND @P__Status IN ('ACCEPTED', 'CANCELLED', 'REJECTED')
                )
                OR
                (
                    -- EXPIRED -> EXPIRED supports the one background call
                    -- after usp_ExpireTransfer has reserved the transfer.
                    [Status] IN ('PENDING', 'EXPIRED')
                    AND @P__Status = 'EXPIRED'
                    AND @ActionDate >= DATEADD(
                        HOUR, @P__TransferExpiryHours, CreatedDate
                    )
                )
            );

        -- Read the update's row count immediately, before any other statement.
        IF @@ROWCOUNT = 0
        BEGIN
            SET @P__Error =
                'Transfer not found, sender posting unfinished, or action not allowed.';
        END;

        -- The updated row was returned by OUTPUT. Do not enter the upsert below.
        RETURN;
    END;
    -- ADDED END

    -- IsInitialAction = 0: existing creation/result/error-update path.
    -- This path is not an authorization to start a banking action.

    IF NOT EXISTS (SELECT 1 FROM t_Transfer WHERE TransferReference = @P__TransferReference)
    BEGIN
        INSERT INTO t_Transfer (
            TransferReference,
            SenderCustomerId,
            SenderExternalId,
            SenderLoginCustomerId,
            SenderDebitAccount,
            SenderDebitCommission,
            SenderFirstName,
            SenderMiddleName,
            SenderLastName,
            SenderMobileNumber,
            InternalAccountNumber,
            ReceiverCustomerId,
            ReceiverExternalId,
            ReceiverFirstName,
            ReceiverMiddleName,
            ReceiverLastName,
            ReceiverMobileNumber,
            ReceiverCreditAccountNumber,
            SentTransferFt,
            ReceivedTransferFt,
            ReversalTransferFt,
            ReversalReason,
            TransferCurrency,
            TransferAmount,
            [Status],
            Notes
        )
        VALUES (
            @P__TransferReference,
            @P__SenderCustomerId,
            @P__SenderExternalId,
            @P__SenderLoginCustomerId,
            @P__SenderDebitAccount,
            @P__SenderDebitCommission,
            @P__SenderFirstName,
            @P__SenderMiddleName,
            @P__SenderLastName,
            @P__SenderMobileNumber,
            @P__InternalAccountNumber,
            @P__ReceiverCustomerId,
            @P__ReceiverExternalId,
            @P__ReceiverFirstName,
            @P__ReceiverMiddleName,
            @P__ReceiverLastName,
            @P__ReceiverMobileNumber,
            @P__ReceiverCreditAccountNumber,
            @P__SentTransferFt,
            @P__ReceivedTransferFt,
            @P__ReversalTransferFt,
            @P__ReversalReason,
            @P__TransferCurrency,
            @P__TransferAmount,
            @P__Status,
            @P__Notes
        );
    END
    ELSE
    BEGIN

        UPDATE t_Transfer
        SET
            SenderCustomerId = COALESCE(@P__SenderCustomerId, SenderCustomerId),
            SenderExternalId = COALESCE(@P__SenderExternalId, SenderExternalId),
            SenderLoginCustomerId = COALESCE(@P__SenderLoginCustomerId, SenderLoginCustomerId),
            SenderDebitAccount = COALESCE(@P__SenderDebitAccount, SenderDebitAccount),
            SenderDebitCommission = COALESCE(@P__SenderDebitCommission, SenderDebitCommission),
            SenderFirstName = COALESCE(@P__SenderFirstName, SenderFirstName),
            SenderMiddleName = COALESCE(@P__SenderMiddleName, SenderMiddleName),
            SenderLastName = COALESCE(@P__SenderLastName, SenderLastName),
            SenderMobileNumber = COALESCE(@P__SenderMobileNumber, SenderMobileNumber),
            InternalAccountNumber = COALESCE(@P__InternalAccountNumber, InternalAccountNumber),
            ReceiverCustomerId = COALESCE(@P__ReceiverCustomerId, ReceiverCustomerId),
            ReceiverExternalId = COALESCE(@P__ReceiverExternalId, ReceiverExternalId),
            ReceiverFirstName = COALESCE(@P__ReceiverFirstName, ReceiverFirstName),
            ReceiverMiddleName = COALESCE(@P__ReceiverMiddleName, ReceiverMiddleName),
            ReceiverLastName = COALESCE(@P__ReceiverLastName, ReceiverLastName),
            ReceiverMobileNumber = COALESCE(@P__ReceiverMobileNumber, ReceiverMobileNumber),
            ReceiverCreditAccountNumber = COALESCE(@P__ReceiverCreditAccountNumber, ReceiverCreditAccountNumber),
            -- CHANGED: Empty placeholders must not erase saved references/reason.
            SentTransferFt = COALESCE(NULLIF(@P__SentTransferFt, ''), SentTransferFt),
            ReceivedTransferFt = COALESCE(NULLIF(@P__ReceivedTransferFt, ''), ReceivedTransferFt),
            ReversalTransferFt = COALESCE(NULLIF(@P__ReversalTransferFt, ''), ReversalTransferFt),
            ReversalReason = COALESCE(NULLIF(@P__ReversalReason, ''), ReversalReason),
            TransferCurrency = COALESCE(@P__TransferCurrency, TransferCurrency),
            TransferAmount = COALESCE(@P__TransferAmount, TransferAmount),

            -- CHANGED: Expiry decisions are handled by the initial-action branch.
            -- Result/error updates record the status supplied by the trusted workflow.
            [Status] = @P__Status,

            Notes = COALESCE(@P__Notes, Notes),
            LastModifiedDate = GETDATE()
        WHERE
            TransferReference = @P__TransferReference;
    END

    SELECT TOP 1 *
    FROM t_Transfer
    WHERE
        TransferReference = @P__TransferReference;

END
