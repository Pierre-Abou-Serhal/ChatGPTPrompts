Sql/usp_GetAccessPolicyAudit.sql
USE [Alterna_AccountStatementManagement];
GO
SET ANSI_NULLS ON;
GO
SET QUOTED_IDENTIFIER ON;
GO

-- SQL Server 2016 compatible, including installations before SP1.
IF OBJECT_ID(N'dbo.usp_GetAccessPolicyAudit', N'P') IS NULL
    EXEC(N'CREATE PROCEDURE dbo.usp_GetAccessPolicyAudit AS BEGIN SET NOCOUNT ON; END;');
GO

ALTER PROCEDURE dbo.usp_GetAccessPolicyAudit
    @P__AccessPolicyId BIGINT = NULL,
    @P__PageNumber INT = 1,
    @P__PageSize INT = 20
AS
BEGIN
    SET NOCOUNT ON;

    IF @P__AccessPolicyId IS NOT NULL AND @P__AccessPolicyId <= 0
        THROW 50001, 'AccessPolicyId must be greater than zero.', 1;

    IF @P__PageNumber IS NULL OR @P__PageNumber < 1
        THROW 50002, 'PageNumber must be greater than zero.', 1;

    IF @P__PageSize IS NULL OR @P__PageSize < 1 OR @P__PageSize > 100
        THROW 50003, 'PageSize must be between 1 and 100.', 1;

    DECLARE @Offset BIGINT = (CONVERT(BIGINT, @P__PageNumber) - 1) * @P__PageSize;

    ;WITH ScopedAudit AS
    (
        SELECT A.*
        FROM dbo.t_ChangeAudit AS A
        -- A rule's persisted parent relationship takes precedence over its
        -- current row. This retains history after a rule is deleted.
        OUTER APPLY
        (
            SELECT TOP (1)
                TRY_CONVERT(BIGINT,
                    CASE WHEN H.Action = 'DELETE' THEN D.OldValue
                         ELSE D.NewValue END) AS AccessPolicyId
            FROM dbo.t_ChangeAudit AS H
            INNER JOIN dbo.t_ChangeAuditDetail AS D
                ON D.ChangeAuditId = H.Id
               AND D.FieldName = N'AccessPolicyId'
            WHERE A.EntityName = N'AccessPolicyRule'
              AND H.EntityName = N'AccessPolicyRule'
              AND H.EntityKey = A.EntityKey
              AND
              (
                  H.ChangedDate < A.ChangedDate
                  OR (H.ChangedDate = A.ChangedDate AND H.Id <= A.Id)
              )
            ORDER BY H.ChangedDate DESC, H.Id DESC
        ) AS HistoricalParent
        OUTER APPLY
        (
            SELECT TOP (1)
                TRY_CONVERT(BIGINT, P.EntityKey) AS AccessPolicyId
            FROM dbo.t_ChangeAudit AS P
            WHERE A.EntityName = N'AccessPolicyRule'
              AND P.ChangeSetId = A.ChangeSetId
              AND P.EntityName = N'AccessPolicy'
            ORDER BY P.Id DESC
        ) AS SameSaveParent
        LEFT JOIN dbo.t_AccessPolicyRule AS R
            ON A.EntityName = N'AccessPolicyRule'
           AND R.Id = TRY_CONVERT(BIGINT, A.EntityKey)
        WHERE A.EntityName IN (N'AccessPolicy', N'AccessPolicyRule')
          AND
          (
              @P__AccessPolicyId IS NULL
              OR
              CASE WHEN A.EntityName = N'AccessPolicy'
                   THEN TRY_CONVERT(BIGINT, A.EntityKey)
                   ELSE COALESCE(HistoricalParent.AccessPolicyId,
                                 SameSaveParent.AccessPolicyId, R.AccessPolicyId)
              END = @P__AccessPolicyId
          )
    ),
    ChangeSetPage AS
    (
        -- Page complete saves BEFORE joining their individual field changes.
        SELECT
            ChangeSetId,
            MAX(ChangedDate) AS SaveChangedDate,
            MAX(Id) AS LastAuditId
        FROM ScopedAudit
        GROUP BY ChangeSetId
        ORDER BY MAX(ChangedDate) DESC, MAX(Id) DESC
        OFFSET @Offset ROWS FETCH NEXT @P__PageSize ROWS ONLY
    )
    SELECT
        A.Id AS ChangeAuditId,
        A.ChangeSetId,
        A.EntityName,
        A.EntityKey,
        A.EntityDisplayName,
        A.Action,
        A.ChangedBy,
        A.ChangedDate,
        D.Id AS ChangeAuditDetailId,
        D.FieldName,
        D.FieldDisplayName,
        D.OldValue,
        D.NewValue
    FROM ChangeSetPage AS P
    INNER JOIN ScopedAudit AS A
        ON A.ChangeSetId = P.ChangeSetId
    INNER JOIN dbo.t_ChangeAuditDetail AS D
        ON D.ChangeAuditId = A.Id
    ORDER BY
        P.SaveChangedDate DESC,
        P.LastAuditId DESC,
        CASE WHEN A.EntityName = N'AccessPolicy' THEN 0 ELSE 1 END,
        A.Id,
        D.Id;
END;
GO

-- Helpful for finding all entity headers belonging to one save.
IF NOT EXISTS
(
    SELECT 1 FROM sys.indexes
    WHERE object_id = OBJECT_ID(N'dbo.t_ChangeAudit')
      AND name = N'IX_t_ChangeAudit_ChangeSetId'
)
    CREATE INDEX IX_t_ChangeAudit_ChangeSetId
        ON dbo.t_ChangeAudit (ChangeSetId);
GO
