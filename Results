/****** Object:  StoredProcedure [dbo].[usp_UpdateDocumentReference]    Script Date: 8/10/2026 4:23:24 PM ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[usp_UpdateDocumentReference]
	@P__DocumentReferenceId BIGINT,
	@P__AccessPolicyId BIGINT,
	@P__IsActive BIT,
	@P__RevokedReason NVARCHAR(255) = NULL,
	@P__User NVARCHAR(255),
	@P__Error NVARCHAR(4000) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    SET @P__Error = NULL;
	
	IF NOT EXISTS (SELECT 1 FROM t_DocumentReference WHERE Id = @P__DocumentReferenceId) 
	BEGIN
		SET @P__Error = 'Docuement reference not found.';
		RETURN;
	END

	IF NOT EXISTS (SELECT 1 FROM t_AccessPolicy WHERE Id = @P__AccessPolicyId)
	BEGIN
		SET @P__Error = 'Access policy not found.';
		RETURN;
	END

	UPDATE t_DocumentReference SET
		AccessPolicyId = @P__AccessPolicyId,
		IsActive = @P__IsActive,
		RevokedBy = CASE WHEN @P__RevokedReason IS NOT NULL THEN @P__User ELSE RevokedBy END,
		RevokedReason = CASE WHEN @P__RevokedReason IS NOT NULL THEN @P__RevokedReason ELSE RevokedReason END,
		RevokedDate = CASE WHEN @P__RevokedReason IS NOT NULL THEN GETDATE() ELSE RevokedDate END,
		LastModifiedBy = @P__User,
		LastModifiedDate = GETDATE()
	WHERE Id = @P__DocumentReferenceId

	SELECT 
		DR.[Id],
		DR.[CustomerId],
		DR.[ExternalId],
		DR.[AccessPolicyId],
		AP.[PolicyName],
		DR.[AccountNumber],
		DR.[DocumentCuk],
		DR.[TokenHash],
		DR.[ExpiredDate],
		DR.[RevokedDate],
		DR.[RevokedBy],
		DR.[RevokedReason],
		DR.[IsActive],
		DR.[CreatedDate],
		DR.[CreatedBy],
		DR.[LastModifiedDate],
		DR.[LastModifiedBy]
	FROM [dbo].[t_DocumentReference] AS DR
	JOIN t_AccessPolicy AS AP ON DR.AccessPolicyId = AP.Id
	WHERE DR.[Id] = @P__DocumentReferenceId;

END

