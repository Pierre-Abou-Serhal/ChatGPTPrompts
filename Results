ALTER PROCEDURE [dbo].[usp_ExpireTransfer]
    @P__TransferReference NVARCHAR(255),
    @P__ExpiredStatus NVARCHAR(255),
    @P__PendingStatus NVARCHAR(255),
	@P__TransferExpiryHours INT,
	@P__RowCount INT OUTPUT,
    @P__Error NVARCHAR(4000) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

	SET @P__RowCount = 0;
    SET @P__Error = NULL;

    IF NOT EXISTS (SELECT 1 FROM t_Transfer WHERE TransferReference = @P__TransferReference)
    BEGIN
       SET @P__Error = 'Transfer not found.';
	   RETURN;
    END
    ELSE
    BEGIN
        UPDATE t_Transfer
        SET 
            [Status] = @P__ExpiredStatus,
            LastModifiedDate = GETDATE()
        WHERE 
            TransferReference = @P__TransferReference
			AND [Status] = @P__PendingStatus
			AND GETDATE() >= DATEADD(HOUR, @P__TransferExpiryHours, CreatedDate);

		SET @P__RowCount = @@ROWCOUNT;
    END

END

