CREATE UNIQUE INDEX UX_t_DocumentReference_TokenHash
ON dbo.t_DocumentReference(TokenHash);

CREATE INDEX IX_t_DocumentAccessAudit_Quota
ON dbo.t_DocumentAccessAudit
(
    DocumentReferenceId,
    CreatedDate
)
WHERE ConsumesQuota = 1;

CREATE INDEX IX_t_AccessPolicyRule_PolicyEnabled
ON dbo.t_AccessPolicyRule
(
    AccessPolicyId,
    IsEnabled
)
INCLUDE
(
    RuleName,
    WindowSeconds,
    MaximumAccessCount
);

CREATE UNIQUE INDEX UX_t_AccessPolicy_PolicyCode
ON dbo.t_AccessPolicy(PolicyCode);

CREATE UNIQUE INDEX UX_t_Config_ActiveSettingName
ON dbo.t_Config(SettingName)
WHERE IsActive = 1;
