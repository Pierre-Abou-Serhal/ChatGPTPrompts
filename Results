Create one mapper that converts flat DTO rows into policy models. The single-policy mapper can reuse the list mapper.

```csharp
public static class AccessPolicyMapper
{
    public static List<AccessPolicy> ToModels(
        IEnumerable<AccessPolicyDbRowDto> dbRows)
    {
        return dbRows
            .GroupBy(row => row.AccessPolicyId)
            .Select(MapPolicyGroup)
            .OrderBy(policy => policy.Id)
            .ToList();
    }

    public static AccessPolicy ToSingleModel(
        IEnumerable<AccessPolicyDbRowDto> dbRows)
    {
        List<AccessPolicy> policies = ToModels(dbRows);

        return policies.Count switch
        {
            1 => policies[0],

            0 => throw new InvalidOperationException(
                "The stored procedure did not return an access policy."),

            _ => throw new InvalidOperationException(
                "The stored procedure returned more than one access policy.")
        };
    }

    private static AccessPolicy MapPolicyGroup(
        IGrouping<Int64, AccessPolicyDbRowDto> policyGroup)
    {
        AccessPolicyDbRowDto firstRow = policyGroup.First();

        return new AccessPolicy
        {
            Id = firstRow.AccessPolicyId,
            PolicyCode = firstRow.AccessPolicyCode,
            PolicyName = firstRow.AccessPolicyName,
            IsEnabled = firstRow.IsAccessPolicyEnabled,
            CreatedDate = firstRow.AccessPolicyCreatedDate,
            CreatedBy = firstRow.AccessPolicyCreatedBy,
            LastModifiedDate =
                firstRow.AccessPolicyLastModifiedDate,
            LastModifiedBy =
                firstRow.AccessPolicyLastModifiedBy,

            AccessPolicyRules = policyGroup
                .Select(MapRule)
                .OrderBy(rule => rule.Id)
                .ToList()
        };
    }

    private static AccessPolicyRule MapRule(
        AccessPolicyDbRowDto row)
    {
        return new AccessPolicyRule
        {
            Id = row.AccessPolicyRuleId,
            AccessPolicyId =
                row.AccessPolicyRuleAccessPolicyId,
            RuleName =
                row.AccessPolicyRuleName,
            WindowSeconds =
                row.AccessPolicyRuleWindowSeconds,
            MaximumAccessCount =
                row.AccessPolicyRuleMaximumAccessCount,
            IsEnabled =
                row.IsAccessPolicyRuleEnabled,
            CreatedDate =
                row.AccessPolicyRuleCreatedDate,
            CreatedBy =
                row.AccessPolicyRuleCreatedBy,
            LastModifiedDate =
                row.AccessPolicyRuleLastModifiedDate,
            LastModifiedBy =
                row.AccessPolicyRuleLastModifiedBy
        };
    }
}
```

Then your list method becomes:

```csharp
public async Task<List<AccessPolicy>> GetAccessPolicy(
    GetAccessPolicyRequest request)
{
    DapperDal dal =
        new DapperDal(_globalSettings.ConnString);

    IEnumerable<AccessPolicyDbRowDto> dbRows =
        await dal.ExecuteQueryAsync<AccessPolicyDbRowDto>(
            "usp_GetAccessPolicy",
            null,
            CommandType.StoredProcedure,
            DapperDal.CommandDirection.Select);

    return AccessPolicyMapper.ToModels(dbRows);
}
```

And the update method uses the same mapping:

```csharp
IEnumerable<AccessPolicyDbRowDto> dbRows =
    await dal.ExecuteQueryAsync<AccessPolicyDbRowDto>(
        "usp_UpdateAccessPolicy",
        parameters,
        CommandType.StoredProcedure,
        DapperDal.CommandDirection.Update);

String? storedProcedureError =
    parameters.Get<String>("P__Error");

if (!String.IsNullOrWhiteSpace(storedProcedureError))
{
    throw new SGBLBadRequestException(
        storedProcedureError);
}

return AccessPolicyMapper.ToSingleModel(dbRows);
```

This keeps the actual field mapping in exactly one place:

* `ToModels()` handles zero or multiple policies.
* `ToSingleModel()` requires exactly one policy.
* `MapPolicyGroup()` builds the policy.
* `MapRule()` builds each rule.
