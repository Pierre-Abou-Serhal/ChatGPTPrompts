ALTER PROCEDURE [dbo].[usp_GetDocumentAccessAudit]
    @P__DocumentReferenceId BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH DocumentAudits AS
    (
        SELECT
            A.*,
            SUM(CONVERT(BIGINT, CASE WHEN A.ConsumesQuota = 1 THEN 1 ELSE 0 END))
                OVER
                (
                    PARTITION BY A.DocumentReferenceId
                    ORDER BY A.CreatedDate, A.Id
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                ) AS LifetimeUsedAccessCount
        FROM dbo.t_DocumentAccessAudit AS A
        WHERE A.DocumentReferenceId = @P__DocumentReferenceId
    )
    SELECT
        DAA.Id,
        DAA.DocumentReferenceId,
        DAA.CorrelationId,
        DAA.PresentedTokenHash,
        DAA.OutcomeCode,
        DAA.ConsumesQuota,
        DAA.DeniedByRuleId,
        CASE WHEN DAA.DeniedByRuleId IS NULL THEN NULL
             ELSE CONCAT(DeniedPolicy.PolicyName, N' : ', DeniedRule.RuleName)
        END AS DeniedByRuleName,
        DAA.IpAddress,
        DAA.UserAgent,
        DAA.CreatedDate,
        DAA.CreatedBy,

        R.AccessPolicyId AS QuotaAccessPolicyId,
        CurrentPolicy.PolicyName AS QuotaAccessPolicyName,
        R.Id AS QuotaRuleId,
        R.RuleName AS QuotaRuleName,
        R.WindowSeconds AS QuotaWindowSeconds,
        R.MaximumAccessCount AS QuotaMaximumAccessCount,
        CONVERT(BIT, Validity.IsConfigurationValid) AS QuotaIsConfigurationValid,
        Usage.UsedAccessCount AS QuotaUsedAccessCount,
        CASE
            WHEN Usage.UsedAccessCount IS NULL THEN CONVERT(BIGINT, NULL)
            WHEN Usage.UsedAccessCount >= R.MaximumAccessCount THEN CONVERT(BIGINT, 0)
            ELSE CONVERT(BIGINT, R.MaximumAccessCount) - Usage.UsedAccessCount
        END AS QuotaRemainingAccessCount
    FROM DocumentAudits AS DAA
    LEFT JOIN dbo.t_AccessPolicyRule AS DeniedRule
        ON DeniedRule.Id = DAA.DeniedByRuleId
    LEFT JOIN dbo.t_AccessPolicy AS DeniedPolicy
        ON DeniedPolicy.Id = DeniedRule.AccessPolicyId
    LEFT JOIN dbo.t_DocumentReference AS DR
        ON DR.Id = DAA.DocumentReferenceId
    LEFT JOIN dbo.t_AccessPolicy AS CurrentPolicy
        ON CurrentPolicy.Id = DR.AccessPolicyId
    LEFT JOIN dbo.t_AccessPolicyRule AS R
        ON R.AccessPolicyId = DR.AccessPolicyId
       AND R.IsEnabled = 1
    CROSS APPLY
    (
        VALUES
        (
            CASE
                WHEN R.Id IS NULL THEN NULL
                WHEN R.MaximumAccessCount > 0
                 AND (R.WindowSeconds IS NULL OR R.WindowSeconds > 0) THEN 1
                ELSE 0
            END
        )
    ) AS Validity(IsConfigurationValid)
    OUTER APPLY
    (
        SELECT COUNT_BIG(*) AS RollingUsedAccessCount
        FROM dbo.t_DocumentAccessAudit AS A
        WHERE Validity.IsConfigurationValid = 1
          AND R.WindowSeconds > 0
          AND A.DocumentReferenceId = DAA.DocumentReferenceId
          AND A.ConsumesQuota = 1
          -- Same exclusive lower boundary as usp_GetDocumentCuk.
          AND A.CreatedDate > DATEADD
          (
              SECOND,
              CASE WHEN R.WindowSeconds > 0 THEN -R.WindowSeconds ELSE NULL END,
              DAA.CreatedDate
          )
          AND
          (
              A.CreatedDate < DAA.CreatedDate
              OR (A.CreatedDate = DAA.CreatedDate AND A.Id <= DAA.Id)
          )
    ) AS RollingUsage
    CROSS APPLY
    (
        VALUES
        (
            CASE
                WHEN Validity.IsConfigurationValid = 1 THEN
                    CASE WHEN R.WindowSeconds IS NULL THEN DAA.LifetimeUsedAccessCount
                         ELSE RollingUsage.RollingUsedAccessCount END
                ELSE CONVERT(BIGINT, NULL)
            END
        )
    ) AS Usage(UsedAccessCount)
    ORDER BY
        DAA.CreatedDate DESC,
        DAA.Id DESC,
        CASE WHEN R.WindowSeconds IS NULL THEN 0 ELSE 1 END,
        R.WindowSeconds,
        R.Id;
END;

