CREATE PROCEDURE [dbo].[sp_Get_File_Receipt] @P__Id BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT r.Id,
           r.OriginalFilename,
           r.OriginalPath,
           r.CurrentPath,
           ri.Code AS IntakeInstitution,
           ei.Code AS EffectiveInstitution,
           r.ChannelCode AS Channel,
           r.CreatedDate AS ReceivedDate,
           r.SourceByteLength AS ByteLength,
           CONVERT(NVARCHAR(64), r.Checksum, 2) AS Checksum,
           r.StatusCode AS ImportState,
           r.LocationStateCode AS LocationState,
           r.DetectedDefinition,
           r.SourceBytes,
           r.ErrorType,
           r.ValidationJson,
           r.DuplicateOf,
           b.Id AS BatchId,
           e.Id AS TechnicalDocumentId,
           e.PublicationState AS TechnicalPublicationState
    FROM dbo.t_File_Receipts r
        JOIN dbo.t_Institutions ri
            ON ri.Id = r.ProposedInstitutionId
        JOIN dbo.t_Institutions ei
            ON ei.Id = r.EffectiveInstitutionId
        LEFT JOIN dbo.t_Payment_Batches b
            ON b.ReceiptId = r.Id
        LEFT JOIN dbo.t_Outgoing_Documents e
            ON e.ReceiptId = r.Id
               AND e.Kind = 'ImportErrorJson'
    WHERE r.Id = @P__Id;
END;
GO

