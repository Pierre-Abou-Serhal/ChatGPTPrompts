  public static DocumentTokenResult GenerateDocumentToken(String baseUrl)
  {
    if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out Uri? baseUri))
    {
      throw new ArgumentException("A valid absolute public URL is required.", nameof(baseUrl));
    }

    // 1. Generate 32 cryptographically secure random bytes.
    Byte[] tokenBytes = RandomNumberGenerator.GetBytes(TokenByteLength);

    // 2. Convert them to a URL-safe 43-character token.
    String rawToken = WebEncoders.Base64UrlEncode(tokenBytes);

    // 3. Hash the original random bytes using SHA-256.
    Byte[] hashBytes = SHA256.HashData(tokenBytes);

    // 4. Convert the 32-byte hash to a 64-character string.
    String tokenHash = Convert.ToHexString(hashBytes).ToLowerInvariant();

    // Put token in URL fragment.
    UriBuilder urlBuilder = new(baseUri)
    {
      Fragment = rawToken
    };

    return new DocumentTokenResult(
      urlBuilder.Uri.AbsoluteUri,
      tokenHash
    );
  }
