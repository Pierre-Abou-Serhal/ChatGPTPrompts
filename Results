      DapperDal dal = new DapperDal(_globalSettings.ConnString);

      DynamicParameters parameters = new DynamicParameters();
      parameters.Add("P__TransferReference", request.TransferReference);
      parameters.Add("P__ExpiredStatus", request.ExpiredStatus);
