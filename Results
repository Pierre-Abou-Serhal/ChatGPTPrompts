using System.Text.Json;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using Microsoft.Extensions.Options;

namespace BAL;

public class BackgroundTaskService(
    IServiceScopeFactory scopeFactory,
    IOptionsMonitor<GlobalSettings> globalSettings,
    ILogger<BackgroundTaskService> logger)
    : BackgroundService
{
    private readonly GlobalSettings _globalSettings = globalSettings.CurrentValue;

    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        while (!stoppingToken.IsCancellationRequested)
        {
            try
            {
                JsonSerializerOptions indentedOptions = new JsonSerializerOptions()
                {
                    WriteIndented = true,
                };

                using var scope = scopeFactory.CreateScope();
                Bal bal = scope.ServiceProvider.GetRequiredService<Bal>();

                String correlationId = Guid.NewGuid().ToString();

                List<Transfer> pendingExpiredTransfers = await bal.GetTransfer(new()
                {
                  BaseReq = new()
                  {
                    CorrelationId = correlationId,
                    Channel = "Windows Service",
                    Platform = "Alterna"
                  },
                  Status = TransferStatus.Pending,
                  TransferExpiryHours = _globalSettings.TransferExpiryHours

                });

                List<Transfer> expiredTransfers = [];

                if (pendingExpiredTransfers.Count > 0)
                {
                    logger.LogInformation($"Pending expired transfers: {pendingExpiredTransfers.Count} \n {JsonSerializer.Serialize(pendingExpiredTransfers, indentedOptions)}");

                    foreach (Transfer pendingExpiredTransfer in pendingExpiredTransfers)
                    {
                      Int32 res = await bal.ExpireTransferAlterna(new ()
                      {
                        TransferReference = pendingExpiredTransfer.TransferReference,
                        TransferExpiryHours =_globalSettings.TransferExpiryHours,
                        ExpiredStatus = TransferStatus.Expired,
                        PendingStatus = TransferStatus.Pending
                      });

                      // successfully set transfer to expired in DB
                      if (res == 1)
                        expiredTransfers.Add(pendingExpiredTransfer);
                    }

                    logger.LogInformation($"Expired transfers: {expiredTransfers.Count} \n {JsonSerializer.Serialize(expiredTransfers, indentedOptions)}");

                    ExpireFtOsbResponse[] returnedTransfers =  await bal.ExpireFtOsb(expiredTransfers);

                    logger.LogInformation($"Transfer Cancelled From OSB: {returnedTransfers.Length} \n {JsonSerializer.Serialize(returnedTransfers, indentedOptions)}");

                    foreach (ExpireFtOsbResponse returnedTransfer in returnedTransfers)
                    {
                      await bal.UpdateTransfer(new()
                        {
                            BaseReq = new()
                            {
                                CorrelationId = correlationId,
                                Channel = "Windows Service",
                                Platform = "Alterna"
                            },
                            TransferReference = returnedTransfer.TransferId,
                            Status = returnedTransfer.ReturnCode == OSBProcessTransferResponseCode.Success
                              ? TransferStatus.Expired
                              : TransferStatus.Failed,
                        });
                    }
                }
            }
            catch (Exception ex)
            {
                logger.LogError(ex.Message);
            }

            Int64 intervalInSeconds = _globalSettings.BackgroundTaskIntervalInSeconds;

            Console.WriteLine(intervalInSeconds);
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(intervalInSeconds), stoppingToken);
            }
            catch (TaskCanceledException)
            {
                break;
            }
        }
    }
}


