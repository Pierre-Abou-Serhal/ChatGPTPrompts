ALTER PROCEDURE [dbo].[usp_GetTransfer]
    @P__TransferReference NVARCHAR(255) = NULL,
    @P__SenderCustomerId NVARCHAR(255) = NULL,
    @P__SenderExternalId NVARCHAR(255) = NULL,
    @P__SenderLoginCustomerId NVARCHAR(255) = NULL,
    @P__SenderDebitAccount NVARCHAR(255) = NULL,
    @P__SenderDebitCommission DECIMAL(18, 4) = NULL,
    @P__SenderFirstName NVARCHAR(255) = NULL,
    @P__SenderMiddleName NVARCHAR(255) = NULL,
    @P__SenderLastName NVARCHAR(255) = NULL,
    @P__SenderMobileNumber NVARCHAR(255) = NULL,
    @P__InternalAccountNumber NVARCHAR(255) = NULL,
    @P__ReceiverCustomerId NVARCHAR(255) = NULL,
    @P__ReceiverExternalId NVARCHAR(255) = NULL,
    @P__ReceiverFirstName NVARCHAR(255) = NULL,
    @P__ReceiverMiddleName NVARCHAR(255) = NULL,
    @P__ReceiverLastName NVARCHAR(255) = NULL,
    @P__ReceiverMobileNumber NVARCHAR(255) = NULL,
    @P__ReceiverCreditAccountNumber NVARCHAR(255) = NULL,
    @P__SentTransferFt NVARCHAR(255) = NULL,
    @P__ReceivedTransferFt NVARCHAR(255) = NULL,
    @P__ReversalTransferFt NVARCHAR(255) = NULL,
    @P__ReversalReason NVARCHAR(255) = NULL,
    @P__TransferCurrency NVARCHAR(255) = NULL,
    @P__TransferAmount DECIMAL(18, 4) = NULL,
    @P__Status NVARCHAR(MAX) = NULL,
    @P__Notes NVARCHAR(MAX) = NULL,
    @P__FromDate DATETIME2(3) = NULL,
    @P__ToDate DATETIME2(3) = NULL,
	@P__TransferExpiryHours INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT * 
    FROM t_Transfer 
    WHERE 
        (@P__TransferReference IS NULL OR TransferReference = @P__TransferReference)
        AND (@P__SenderCustomerId IS NULL OR SenderCustomerId = @P__SenderCustomerId)
        AND (@P__SenderExternalId IS NULL OR SenderExternalId = @P__SenderExternalId)
        AND (@P__SenderLoginCustomerId IS NULL OR SenderLoginCustomerId = @P__SenderLoginCustomerId)
        AND (@P__SenderDebitAccount IS NULL OR SenderDebitAccount = @P__SenderDebitAccount)
        AND (@P__SenderDebitCommission IS NULL OR SenderDebitCommission = @P__SenderDebitCommission)
        AND (@P__SenderFirstName IS NULL OR SenderFirstName = @P__SenderFirstName)
        AND (@P__SenderMiddleName IS NULL OR SenderMiddleName = @P__SenderMiddleName)
        AND (@P__SenderLastName IS NULL OR SenderLastName = @P__SenderLastName)
        AND (@P__SenderMobileNumber IS NULL OR SenderMobileNumber = @P__SenderMobileNumber)
        AND (@P__InternalAccountNumber IS NULL OR InternalAccountNumber = @P__InternalAccountNumber)
        AND (@P__ReceiverCustomerId IS NULL OR ReceiverCustomerId = @P__ReceiverCustomerId)
        AND (@P__ReceiverExternalId IS NULL OR ReceiverExternalId = @P__ReceiverExternalId)
        AND (@P__ReceiverFirstName IS NULL OR ReceiverFirstName = @P__ReceiverFirstName)
        AND (@P__ReceiverMiddleName IS NULL OR ReceiverMiddleName = @P__ReceiverMiddleName)
        AND (@P__ReceiverLastName IS NULL OR ReceiverLastName = @P__ReceiverLastName)
        AND (@P__ReceiverMobileNumber IS NULL OR ReceiverMobileNumber = @P__ReceiverMobileNumber)
        AND (@P__ReceiverCreditAccountNumber IS NULL OR ReceiverCreditAccountNumber = @P__ReceiverCreditAccountNumber)
        AND (@P__SentTransferFt IS NULL OR SentTransferFt = @P__SentTransferFt)
        AND (@P__ReceivedTransferFt IS NULL OR ReceivedTransferFt = @P__ReceivedTransferFt)
        AND (@P__ReversalTransferFt IS NULL OR ReversalTransferFt = @P__ReversalTransferFt)
        AND (@P__ReversalReason IS NULL OR ReversalReason = @P__ReversalReason)
        AND (@P__TransferCurrency IS NULL OR TransferCurrency = @P__TransferCurrency)
        AND (@P__TransferAmount IS NULL OR TransferAmount = @P__TransferAmount)
        AND (@P__Status IS NULL OR [Status] IN (SELECT VALUE FROM STRING_SPLIT(@P__Status, ',')))
        
        -- Wildcard Partial Match for Notes
        AND (@P__Notes IS NULL OR Notes LIKE '%' + @P__Notes + '%')
        
        -- Date Range Queries
        AND (@P__FromDate IS NULL OR CreatedDate >= @P__FromDate)
        AND (@P__ToDate IS NULL OR CreatedDate <= @P__ToDate)

		AND (@P__TransferExpiryHours IS NULL OR GETDATE() >= DATEADD(HOUR, @P__TransferExpiryHours, CreatedDate))
		ORDER BY CreatedDate DESC;
END

