CREATE PROCEDURE [dbo].[sp_List_Batch_Categories] @P__Id BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT c.Category,
           COUNT(t.Id) AS TransferCount,
           CASE
               WHEN c.Category = 'INVALID' THEN
                   'NotRequired'
               WHEN COUNT(t.Id) = 0 THEN
                   'NotApplicable'
               WHEN c.ProcessedDate IS NULL THEN
                   'NotProcessed'
               ELSE
                   'Processed'
           END AS ProcessingState,
           c.ProcessedDate,
           c.ProcessedBy AS ProcessedActor
    FROM dbo.t_Batch_Categories c
        LEFT JOIN dbo.t_Transfers t
            ON t.BatchId = c.BatchId
               AND t.Category = c.Category
    WHERE c.BatchId = @P__Id
    GROUP BY c.Category,
             c.ProcessedDate,
             c.ProcessedBy
    ORDER BY CASE c.Category
                 WHEN 'LOCAL' THEN
                     1
                 WHEN 'ACH' THEN
                     2
                 WHEN 'RTGS' THEN
                     3
                 WHEN 'SWIFT' THEN
                     4
                 ELSE
                     5
             END;
END;
GO

