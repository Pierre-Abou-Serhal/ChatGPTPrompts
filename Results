using System;
using System.Collections.Generic;

// Replace the existing DocumentAccessAudit class in its current namespace.
public class DocumentAccessAudit
{
    public long Id { get; set; }
    public long? DocumentReferenceId { get; set; }
    public string CorrelationId { get; set; } = string.Empty;
    public string PresentedTokenHash { get; set; } = string.Empty;
    public string OutcomeCode { get; set; } = string.Empty;
    public bool ConsumesQuota { get; set; }
    public long? DeniedByRuleId { get; set; }
    public string? DeniedByRuleName { get; set; }
    public string? IpAddress { get; set; }
    public string? UserAgent { get; set; }
    public DateTime? CreatedDate { get; set; }
    public string? CreatedBy { get; set; }

    // All balances are reconstructed at CreatedDate/Id with current rules.
    public string QuotaCalculationBasis { get; set; } = "CurrentPolicyRules";
    public List<DocumentAccessRuleBalance> RemainingScansByRule { get; set; } = [];
}

public class DocumentAccessRuleBalance
{
    public long AccessPolicyId { get; set; }
    public string AccessPolicyName { get; set; } = string.Empty;
    public long RuleId { get; set; }
    public string RuleName { get; set; } = string.Empty;
    public int? WindowSeconds { get; set; }
    public int MaximumAccessCount { get; set; }
    public long? UsedAccessCount { get; set; }
    public long? RemainingAccessCount { get; set; }
    public bool IsConfigurationValid { get; set; }
    public bool? IsLimitReached => RemainingAccessCount.HasValue
        ? RemainingAccessCount.Value == 0 : null;
}

// Flat SQL result: one row for each audit/rule pair. Do not return this
// derived type directly from the API; the mapper creates the base model.
public class DocumentAccessAuditDbRow : DocumentAccessAudit
{
    public long? QuotaAccessPolicyId { get; set; }
    public string? QuotaAccessPolicyName { get; set; }
    public long? QuotaRuleId { get; set; }
    public string? QuotaRuleName { get; set; }
    public int? QuotaWindowSeconds { get; set; }
    public int? QuotaMaximumAccessCount { get; set; }
    public bool? QuotaIsConfigurationValid { get; set; }
    public long? QuotaUsedAccessCount { get; set; }
    public long? QuotaRemainingAccessCount { get; set; }
}
