f='Alterna.business.svc/classes/pom.xml'

git status --short -- "$f"
git diff --raw --no-ext-diff --no-textconv -- "$f"
git diff --cached --raw --no-ext-diff --no-textconv -- "$f"
git ls-files --eol -- "$f"

# Content identifiers: committed, staged, and current working file
git rev-parse "HEAD:$f"
git rev-parse ":$f"
git hash-object --path="$f" -- "$f"
