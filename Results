CREATE PROCEDURE [dbo].[usp_CreateDocumentReference]
	@P__CustomerId NVARCHAR(255),
	@P__ExternalId NVARCHAR(255),
	@P__AccountNumber NVARCHAR(255),
	@P__DocumentCuk NVARCHAR(255),
	@P__DocumentTokenHash NVARCHAR(255),
	@P__Error NVARCHAR(4000) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    SET @P__Error = NULL;
	
	DECLARE @DocExpiryInDays INT = NULL; -- DOCUMENT_EXPIRY_IN_DAYS
	DECLARE @DefaulyAccessPolicyCode NVARCHAR(255) = NULL; -- DEFAULT_ACCESS_POLICY
	DECLARE @DefaulyAccessPolicyId BIGINT = NULL;
	DECLARE @CurrentDate DATETIME2(3) = GETDATE();

	-- 1- Try to get config values
	SELECT @DocExpiryInDays = TRY_CONVERT(INT, SettingValue)
	FROM t_Config 
		WHERE SettingName = 'DOCUMENT_EXPIRY_IN_DAYS'
		AND IsActive = 1;

	SELECT @DefaulyAccessPolicyCode = SettingValue
	FROM t_Config 
		WHERE SettingName = 'DEFAULT_ACCESS_POLICY'
		AND IsActive = 1;

	IF @DocExpiryInDays IS NULL
	BEGIN
		SET @P__Error = 'DB document expiry in days config not set';
		RETURN
	END

	IF @DefaulyAccessPolicyCode IS NULL
	BEGIN
		SET @P__Error = 'DB default access policy config not set';
		RETURN
	END

	-- 2- Try to get default access policy id from table
	SELECT @DefaulyAccessPolicyId = Id
	FROM t_AccessPolicy 
		WHERE PolicyCode = @DefaulyAccessPolicyCode
		AND IsEnabled = 1;

	IF @DefaulyAccessPolicyId IS NULL
	BEGIN
		SET @P__Error = 'Could not find the default access policy in DB';
		RETURN
	END

	INSERT INTO [dbo].[t_DocumentReference]
	(
		CustomerId,
		ExternalId,
		AccessPolicyId,
		AccountNumber,
		DocumentCuk,
		TokenHash,
		ExpiredDate,
		IsActive,
		CreatedDate,
		CreatedBy,
		LastModifiedDate,
		LastModifiedBy
	)
	VALUES
	(
		@P__CustomerId,
		@P__ExternalId,
		@DefaulyAccessPolicyId,
		@P__AccountNumber,
		@P__DocumentCuk,
		@P__DocumentTokenHash,
		DATEADD(day, @DocExpiryInDays, @CurrentDate),
		1,
		@CurrentDate,
		@P__CustomerId,
		@CurrentDate,
		@P__CustomerId
	)
END

