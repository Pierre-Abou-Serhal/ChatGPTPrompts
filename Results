USE [Alterna_AccountStatementManagement]
GO

ALTER PROCEDURE [dbo].[usp_GetDocumentCuk]
(
    @P__RawTokenHash  NVARCHAR(255),
    @P__CorrelationId NVARCHAR(255),
    @P__IpAddress     NVARCHAR(255),
    @P__UserAgent     NVARCHAR(255),
    @P__Error         NVARCHAR(4000) OUTPUT
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @CurrentDate DATETIME2(3) = GETDATE();

    DECLARE @TokenHash NVARCHAR(255) =
        LOWER(
            LTRIM(
                RTRIM(
                    ISNULL(@P__RawTokenHash, N'')
                )
            )
        );

    DECLARE @CorrelationId NVARCHAR(255) =
        COALESCE
        (
            NULLIF(
                LTRIM(RTRIM(@P__CorrelationId)),
                N''
            ),
            CONVERT(NVARCHAR(36), NEWID())
        );

    DECLARE @DocumentReferenceId BIGINT = NULL;
    DECLARE @AccessPolicyId BIGINT = NULL;
    DECLARE @DocumentCuk NVARCHAR(255) = NULL;
    DECLARE @ExpiredDate DATETIME2(3) = NULL;
    DECLARE @RevokedDate DATETIME2(3) = NULL;
    DECLARE @DocumentIsActive BIT = NULL;
    DECLARE @PolicyIsEnabled BIT = NULL;

    DECLARE @Allowed BIT = 0;
    DECLARE @ConsumesQuota BIT = 0;
    DECLARE @OutcomeCode NVARCHAR(255) = N'UNDETERMINED';

    DECLARE @DeniedRuleId BIGINT = NULL;
    DECLARE @DeniedRuleName NVARCHAR(255) = NULL;
    DECLARE @CurrentAccessCount BIGINT = NULL;
    DECLARE @MaximumAccessCount INT = NULL;
    DECLARE @WindowSeconds INT = NULL;

    /*
     * Only enabled rules will be loaded into this table.
     *
     * Loading them once ensures every subsequent validation uses
     * the same rule set during this transaction.
     */
    DECLARE @ActiveRules TABLE
    (
        Id                 BIGINT        NOT NULL,
        RuleName           NVARCHAR(255) NOT NULL,
        WindowSeconds      INT           NULL,
        MaximumAccessCount INT           NOT NULL,

        PRIMARY KEY (Id)
    );

    SET @P__Error = NULL;

    BEGIN TRY
        BEGIN TRANSACTION;

        /*
         * C# already validates this format, but the procedure also
         * validates it in case it is called from another source.
         */
        IF LEN(@TokenHash) <> 64
           OR @TokenHash COLLATE Latin1_General_100_BIN2
                LIKE N'%[^0-9a-f]%'
        BEGIN
            SET @OutcomeCode = N'INVALID_TOKEN_FORMAT';
            SET @P__Error = N'The document token is invalid.';
        END
        ELSE
        BEGIN
            /*
             * Serialize access attempts for the same document.
             *
             * This prevents two simultaneous requests from both
             * passing a quota rule at the same time.
             */
            SELECT
                @DocumentReferenceId = d.Id,
                @AccessPolicyId = d.AccessPolicyId,
                @DocumentCuk = d.DocumentCuk,
                @ExpiredDate = d.ExpiredDate,
                @RevokedDate = d.RevokedDate,
                @DocumentIsActive = d.IsActive,
                @PolicyIsEnabled = p.IsEnabled
            FROM dbo.t_DocumentReference AS d
                WITH (UPDLOCK, HOLDLOCK)
            INNER JOIN dbo.t_AccessPolicy AS p
                WITH (HOLDLOCK)
                ON p.Id = d.AccessPolicyId
            WHERE d.TokenHash = @TokenHash;

            /*
             * Load and lock the active rules once.
             *
             * Disabled rules are not loaded, validated or evaluated.
             */
            IF @DocumentReferenceId IS NOT NULL
            BEGIN
                INSERT INTO @ActiveRules
                (
                    Id,
                    RuleName,
                    WindowSeconds,
                    MaximumAccessCount
                )
                SELECT
                    r.Id,
                    r.RuleName,
                    r.WindowSeconds,
                    r.MaximumAccessCount
                FROM dbo.t_AccessPolicyRule AS r
                    WITH (HOLDLOCK)
                WHERE r.AccessPolicyId = @AccessPolicyId
                  AND r.IsEnabled = 1;
            END;

            /*
             * Refresh the time after any lock waiting.
             */
            SET @CurrentDate = GETDATE();

            IF @DocumentReferenceId IS NULL
            BEGIN
                SET @OutcomeCode = N'INVALID_TOKEN';
                SET @P__Error = N'The document token is invalid.';
            END
            ELSE IF @RevokedDate IS NOT NULL
            BEGIN
                SET @OutcomeCode = N'DOCUMENT_REVOKED';
                SET @P__Error =
                    N'Document access has been revoked.';
            END
            ELSE IF @DocumentIsActive = 0
            BEGIN
                SET @OutcomeCode = N'DOCUMENT_INACTIVE';
                SET @P__Error =
                    N'The requested document is not available.';
            END
            ELSE IF @CurrentDate >= @ExpiredDate
            BEGIN
                SET @OutcomeCode = N'DOCUMENT_EXPIRED';
                SET @P__Error =
                    N'Document access has expired.';
            END
            ELSE IF ISNULL(@PolicyIsEnabled, 0) = 0
            BEGIN
                SET @OutcomeCode = N'POLICY_DISABLED';
                SET @P__Error =
                    N'The document access policy is disabled.';
            END
            ELSE IF NOT EXISTS
            (
                SELECT 1
                FROM @ActiveRules
            )
            BEGIN
                /*
                 * Fail closed when every policy rule is disabled
                 * or the policy has no rules.
                 */
                SET @OutcomeCode =
                    N'POLICY_RULE_NOT_CONFIGURED';

                SET @P__Error =
                    N'No enabled access rules are configured for this policy.';
            END
            ELSE IF EXISTS
            (
                SELECT 1
                FROM @ActiveRules
                WHERE MaximumAccessCount <= 0
                   OR
                   (
                       WindowSeconds IS NOT NULL
                       AND WindowSeconds <= 0
                   )
            )
            BEGIN
                /*
                 * Only enabled rules are checked for configuration
                 * errors. Invalid disabled rules are ignored.
                 */
                SET @OutcomeCode =
                    N'POLICY_CONFIGURATION_INVALID';

                SET @P__Error =
                    N'The document access policy contains an invalid enabled rule.';
            END
            ELSE
            BEGIN
                /*
                 * WindowSeconds IS NULL:
                 *     Lifetime rule. Count every successful access.
                 *
                 * WindowSeconds has a value:
                 *     Rolling rule. Count only successful accesses
                 *     inside the configured window.
                 */
                SELECT TOP (1)
                    @DeniedRuleId = r.Id,
                    @DeniedRuleName = r.RuleName,
                    @WindowSeconds = r.WindowSeconds,
                    @MaximumAccessCount =
                        r.MaximumAccessCount,
                    @CurrentAccessCount =
                        q.CurrentAccessCount
                FROM @ActiveRules AS r
                CROSS APPLY
                (
                    SELECT
                        COUNT_BIG(1) AS CurrentAccessCount
                    FROM dbo.t_DocumentAccessAudit AS a
                    WHERE a.DocumentReferenceId =
                              @DocumentReferenceId
                      AND a.ConsumesQuota = 1
                      AND
                      (
                          r.WindowSeconds IS NULL
                          OR a.CreatedDate >
                             DATEADD
                             (
                                 SECOND,
                                 -r.WindowSeconds,
                                 @CurrentDate
                             )
                      )
                      AND a.CreatedDate <= @CurrentDate
                ) AS q
                WHERE q.CurrentAccessCount >=
                      r.MaximumAccessCount
                ORDER BY
                    /*
                     * Select the shortest failed rolling rule first.
                     * Lifetime rules are selected after rolling rules.
                     */
                    CASE
                        WHEN r.WindowSeconds IS NULL THEN 1
                        ELSE 0
                    END,
                    r.WindowSeconds,
                    r.Id;

                IF @DeniedRuleId IS NOT NULL
                BEGIN
                    SET @OutcomeCode =
                        N'ACCESS_LIMIT_EXCEEDED';

                    SET @P__Error =
                        LEFT
                        (
                            CONCAT
                            (
                                N'Access limit exceeded. Rule: ',
                                @DeniedRuleName,
                                N'; current count: ',
                                @CurrentAccessCount,
                                N'; maximum: ',
                                @MaximumAccessCount,
                                CASE
                                    WHEN @WindowSeconds IS NULL
                                    THEN N'; window: lifetime.'
                                    ELSE CONCAT
                                    (
                                        N'; window seconds: ',
                                        @WindowSeconds,
                                        N'.'
                                    )
                                END
                            ),
                            4000
                        );
                END
                ELSE
                BEGIN
                    SET @Allowed = 1;
                    SET @ConsumesQuota = 1;
                    SET @OutcomeCode = N'ACCESS_GRANTED';
                    SET @P__Error = NULL;
                END;
            END;
        END;

        /*
         * Every expected validation attempt is recorded.
         *
         * Only ACCESS_GRANTED consumes quota.
         */
        INSERT INTO dbo.t_DocumentAccessAudit
        (
            DocumentReferenceId,
            CorrelationId,
            PresentedTokenHash,
            OutcomeCode,
            ConsumesQuota,
            DeniedByRuleId,
            IpAddress,
            UserAgent,
            CreatedDate
        )
        VALUES
        (
            @DocumentReferenceId,
            @CorrelationId,
            @TokenHash,
            @OutcomeCode,
            @ConsumesQuota,
            @DeniedRuleId,
            @P__IpAddress,
            @P__UserAgent,
            @CurrentDate
        );

        COMMIT TRANSACTION;

        IF @Allowed = 1
        BEGIN
            SELECT @DocumentCuk AS DocumentCuk;
            RETURN 0;
        END;

        SELECT
            CAST(NULL AS NVARCHAR(255))
                AS DocumentCuk;

        RETURN 1;
    END TRY
    BEGIN CATCH
        IF XACT_STATE() <> 0
        BEGIN
            ROLLBACK TRANSACTION;
        END;

        /*
         * Unexpected SQL errors are thrown to C#.
         *
         * They should be handled as internal server errors,
         * not converted into SGBLBadRequestException.
         */
        THROW;
    END CATCH;
END
GO
