CREATE PROCEDURE [dbo].[sp_Get_Currency_Totals] @P__Id BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT Currency,
           CONVERT(NVARCHAR(50), SUM(Amount)) AS Amount
    FROM
    (
        SELECT InstructedCurrency AS Currency,
               InstructedAmount AS Amount
        FROM dbo.t_Transfers
        WHERE BatchId = @P__Id
              AND InstructedAmount IS NOT NULL
        UNION ALL
        SELECT EquivalentCurrency,
               EquivalentAmount
        FROM dbo.t_Transfers
        WHERE BatchId = @P__Id
              AND EquivalentAmount IS NOT NULL
    ) amounts
    GROUP BY Currency
    ORDER BY Currency;
END;
