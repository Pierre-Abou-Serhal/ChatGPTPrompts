  #region Cancel FT
  public async Task<ExpireFtOsbResponse[]> ExpireFtOsb(List<Transfer> pendingTransfers)
  {
      IEnumerable<Task<ExpireFtOsbResponse>> tasks = pendingTransfers
        .Select(async i =>
      {
          try
          {
              ExpireFtOSBRequest request = new ExpireFtOSBRequest()
              {
                  CorrelationId = Guid.NewGuid().ToString(),
                  TransferId = i.TransferReference,
                  CustomerId = Int32.Parse(i.SenderCustomerId!),
                  ExternalId = i.SenderExternalId!,
                  Action = OSBProcessTransferStatus.Expired,
                  Platform = "Alterna",
                  Channel = "Windows Service"
              };

              (ExpireFtOsbResponse expireFtOsbResponse, _) =
                  await PostAsync<ExpireFtOsbResponse>(request,
                      $"{_globalSettings.OSBEndpointUrl}Moma/processTransfer");

              return expireFtOsbResponse;
          }
          catch (Exception ex)
          {
              _logger.LogError($"Error occured while cancelling transfer: {i.TransferReference} by calling OSB API. \nError: {ex.Message}");

              String sendEmailUsername = "AlternaSysUser";
              String emailSubject = $"Technical error occured while cancelling {_globalSettings.AppUsername} transfer through OSB. Transfer Ref: {i.TransferReference}";

              SendEmailRequest sendEmailRequest = new()
              {
                  Username = sendEmailUsername,
                  CorrelationId = i.TransferReference,
                  PublicKey = TokenGenerator.GeneratePublicKey(sendEmailUsername, i.TransferReference, _globalSettings.EmailSalt),
                  EmailParameters = new()
                  {
                      EmailFrom = _globalSettings.SendEmailFrom,
                      EmailTo = _globalSettings.AlternaErrorSendEmailTo,
                      Subject = emailSubject,
                      Body = $"{_globalSettings.AppUsername} Transfer Reference: {i.TransferReference}. \nError Reason: {ex.Message}. \n Please contact support to check this issue.",
                  }
              };

              JsonSerializerOptions indentedOptions = new JsonSerializerOptions()
              {
                  WriteIndented = true
              };

              _logger.LogInformation($"Sending Email From Alterna With The Following Request: \n{JsonSerializer.Serialize(sendEmailRequest, indentedOptions)}");

              await PostAsync<dynamic>(sendEmailRequest, $"{_globalSettings.SendEmailApiUrl}api/Email/SendEmail");

              return new ExpireFtOsbResponse();
          }
      });

      ExpireFtOsbResponse[] response = await Task.WhenAll(tasks);

      return response;
  }
  #endregion

