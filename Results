using System;
using System.Collections.Generic;

public static class DocumentAccessAuditMapper
{
    public static DocumentAccessAuditResult ToResult(IEnumerable<DocumentAccessAuditDbRow> rows)
    {
        ArgumentNullException.ThrowIfNull(rows);
        DocumentAccessAuditResult result = new();

        // Preserve SQL order independently within each list.
        foreach (DocumentAccessAuditDbRow row in rows)
        {
            switch (row.RowType)
            {
                case "Audit":
                    result.DocumentAccessAuditList.Add(new DocumentAccessAudit
                    {
                        Id = row.Id,
                        DocumentReferenceId = row.DocumentReferenceId,
                        CorrelationId = row.CorrelationId,
                        PresentedTokenHash = row.PresentedTokenHash,
                        OutcomeCode = row.OutcomeCode,
                        ConsumesQuota = row.ConsumesQuota,
                        DeniedByRuleId = row.DeniedByRuleId,
                        DeniedByRuleName = row.DeniedByRuleName,
                        IpAddress = row.IpAddress,
                        UserAgent = row.UserAgent,
                        CreatedDate = row.CreatedDate,
                        CreatedBy = row.CreatedBy
                    });
                    break;

                case "Quota":
                    result.RemainingScansByRule.Add(new DocumentAccessRuleBalance
                    {
                        AccessPolicyId = row.QuotaAccessPolicyId
                            ?? throw new InvalidOperationException("A quota row is missing its policy ID."),
                        AccessPolicyName = row.QuotaAccessPolicyName ?? string.Empty,
                        RuleId = row.QuotaRuleId
                            ?? throw new InvalidOperationException("A quota row is missing its rule ID."),
                        RuleName = row.QuotaRuleName ?? string.Empty,
                        WindowSeconds = row.QuotaWindowSeconds,
                        MaximumAccessCount = row.QuotaMaximumAccessCount
                            ?? throw new InvalidOperationException("A quota row is missing its maximum count."),
                        UsedAccessCount = row.QuotaUsedAccessCount,
                        RemainingAccessCount = row.QuotaRemainingAccessCount,
                        IsConfigurationValid = row.QuotaIsConfigurationValid == true
                    });
                    break;

                default:
                    throw new InvalidOperationException("Unexpected document access audit row type. Check the deployed stored procedure version.");
            }
        }

        return result;
    }
}






