git diff --name-only --diff-filter=M -z |
while IFS= read -r -d '' file; do
    if git --literal-pathspecs diff --quiet --no-ext-diff --no-textconv \
        --ignore-cr-at-eol -- "$file"; then

        git --literal-pathspecs restore --worktree -- "$file" || break
        printf 'Cleared: %s\n' "$file"
    fi
done

git status --short
