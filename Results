CREATE PROCEDURE [dbo].[sp_List_Transfers]
    @P__Id BIGINT,
    @P__Category NVARCHAR(50),
    @P__Decision NVARCHAR(50),
    @P__GroupId BIGINT,
    @P__Skip INT,
    @P__Take INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT t.Id,
           t.GroupId,
           g.SourceOrdinal AS GroupOrdinal,
           t.SourceOrdinal,
           g.PaymentInfoId,
           g.DebtorAccountId AS DebtorAccount,
           t.InstructionId,
           t.EndToEndId,
           t.CreditorName,
           t.CreditorAccountId AS CreditorAccount,
           t.CreditorAccountKind,
           CONVERT(NVARCHAR(50), COALESCE(t.InstructedAmount, t.EquivalentAmount)) AS Amount,
           COALESCE(t.InstructedCurrency, t.EquivalentCurrency) AS Currency,
           t.TransferCurrency,
           CASE
               WHEN t.InstructedAmount IS NOT NULL THEN
                   'Instructed'
               ELSE
                   'Equivalent'
           END AS AmountBasis,
           t.Category,
           t.Decision,
           t.DecisionSource,
           t.DecisionReason,
           t.RoutingCode,
           t.RoutingExplanation
    FROM dbo.t_Transfers t
        JOIN dbo.t_Payment_Groups g
            ON g.Id = t.GroupId
    WHERE t.BatchId = @P__Id
          AND (
                  @P__Category IS NULL
                  OR t.Category = @P__Category
              )
          AND (
                  @P__Decision IS NULL
                  OR t.Decision = @P__Decision
              )
          AND (
                  @P__GroupId IS NULL
                  OR t.GroupId = @P__GroupId
              )
    ORDER BY g.SourceOrdinal,
             t.SourceOrdinal OFFSET @P__Skip ROWS FETCH NEXT @P__Take ROWS ONLY;
END;
GO

