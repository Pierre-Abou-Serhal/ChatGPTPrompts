RelatedCustomers AS
(
    SELECT DISTINCT
        INPUT.InputedId,
        CUSTOMER.RelCustomer,
        INPUT.Currency
    FROM ParsedAccounts AS INPUT
    INNER JOIN [dbo].[tblCustomer] AS CUSTOMER
        ON CUSTOMER.Id = INPUT.CustomerId
       AND CUSTOMER.RelationCode = 9
    WHERE CUSTOMER.RelCustomer IS NOT NULL
      AND EXISTS
      (
          SELECT 1
          FROM [dbo].[tblCustomer] AS RELATED_CUSTOMER
          WHERE RELATED_CUSTOMER.Id =
                TRY_CONVERT(INT, CUSTOMER.RelCustomer)
            AND RELATED_CUSTOMER.CompanyBook = 'LB0010307'
      )
),
