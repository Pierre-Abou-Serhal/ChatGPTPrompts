CREATE PROCEDURE [dbo].[sp_Upsert_Response_Mapping]
    @P__InstitutionId BIGINT,
    @P__Input NVARCHAR(32),
    @P__Output NVARCHAR(32),
    @P__ModifiedBy NVARCHAR(255) = N'AlternaSystem'
AS
BEGIN
    SET NOCOUNT ON;

    -- The caller supplies the transaction for the update and insert.
    UPDATE dbo.t_Response_Mappings WITH (UPDLOCK, HOLDLOCK)
    SET OutputCode = @P__Output,
        Revision = Revision + 1,
        LastModifiedBy = @P__ModifiedBy,
        LastModifiedDate = GETDATE()
    WHERE InstitutionId = @P__InstitutionId
          AND InputCode = @P__Input;

    IF @@ROWCOUNT = 0
    BEGIN
        INSERT dbo.t_Response_Mappings
        (
            InstitutionId,
            InputCode,
            OutputCode,
            CreatedBy,
            LastModifiedBy
        )
        VALUES
        (@P__InstitutionId, @P__Input, @P__Output, @P__ModifiedBy, @P__ModifiedBy);
    END;
END;
GO

