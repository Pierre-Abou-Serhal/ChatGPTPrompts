ALTER PROCEDURE dbo.usp_GetDocumentAccessAudit
    @P__DocumentReferenceId BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    -- Use the same clock and precision as dbo.usp_GetDocumentCuk.
    DECLARE @CurrentDate DATETIME2(3) = GETDATE();

    ;WITH ConfiguredRules AS
    (
        SELECT
            DR.Id AS DocumentReferenceId,
            P.Id AS QuotaAccessPolicyId,
            P.PolicyName AS QuotaAccessPolicyName,
            R.Id AS QuotaRuleId,
            R.RuleName AS QuotaRuleName,
            R.WindowSeconds AS QuotaWindowSeconds,
            COALESCE(R.MaximumAccessCount, 0) AS QuotaMaximumAccessCount,
            CAST(CASE WHEN R.MaximumAccessCount > 0
                       AND (R.WindowSeconds IS NULL OR R.WindowSeconds > 0)
                      THEN 1 ELSE 0 END AS BIT) AS QuotaIsConfigurationValid
        FROM dbo.t_DocumentReference AS DR
        INNER JOIN dbo.t_AccessPolicy AS P ON P.Id = DR.AccessPolicyId
        INNER JOIN dbo.t_AccessPolicyRule AS R
            ON R.AccessPolicyId = P.Id
           AND R.IsEnabled = 1
        WHERE DR.Id = @P__DocumentReferenceId
    ), RuleUsage AS
    (
        SELECT R.*,
            CASE WHEN R.QuotaIsConfigurationValid = 1 THEN
            (
                SELECT COUNT_BIG(*)
                FROM dbo.t_DocumentAccessAudit AS A
                WHERE A.DocumentReferenceId = R.DocumentReferenceId
                  AND A.ConsumesQuota = 1
                  AND A.CreatedDate <= @CurrentDate
                  AND
                  (
                      R.QuotaWindowSeconds IS NULL
                      OR A.CreatedDate > DATEADD
                      (
                          SECOND,
                          -CASE WHEN R.QuotaWindowSeconds > 0 THEN R.QuotaWindowSeconds END,
                          @CurrentDate
                      )
                  )
            ) END AS QuotaUsedAccessCount
        FROM ConfiguredRules AS R
    ), ResultRows AS
    (
        -- One row per recorded attempt. Do not join it to current rules.
        SELECT
            'Audit' AS RowType,
            DAA.Id,
            DAA.DocumentReferenceId,
            DAA.CorrelationId,
            DAA.PresentedTokenHash,
            DAA.OutcomeCode,
            DAA.ConsumesQuota,
            DAA.DeniedByRuleId,
            CASE WHEN DAA.DeniedByRuleId IS NULL THEN NULL
                 ELSE CONCAT(DeniedPolicy.PolicyName, N' : ', DeniedRule.RuleName)
            END AS DeniedByRuleName,
            DAA.IpAddress,
            DAA.UserAgent,
            DAA.CreatedDate,
            DAA.CreatedBy,
            CAST(NULL AS BIGINT) AS QuotaAccessPolicyId,
            CAST(NULL AS NVARCHAR(1)) AS QuotaAccessPolicyName,
            CAST(NULL AS BIGINT) AS QuotaRuleId,
            CAST(NULL AS NVARCHAR(1)) AS QuotaRuleName,
            CAST(NULL AS INT) AS QuotaWindowSeconds,
            CAST(NULL AS INT) AS QuotaMaximumAccessCount,
            CAST(NULL AS BIT) AS QuotaIsConfigurationValid,
            CAST(NULL AS BIGINT) AS QuotaUsedAccessCount,
            CAST(NULL AS BIGINT) AS QuotaRemainingAccessCount
        FROM dbo.t_DocumentAccessAudit AS DAA
        LEFT JOIN dbo.t_AccessPolicyRule AS DeniedRule
            ON DeniedRule.Id = DAA.DeniedByRuleId
        LEFT JOIN dbo.t_AccessPolicy AS DeniedPolicy
            ON DeniedPolicy.Id = DeniedRule.AccessPolicyId
        WHERE DAA.DocumentReferenceId = @P__DocumentReferenceId

        UNION ALL

        -- One row per enabled rule, even if the document has no attempts.
        SELECT
            'Quota',
            CAST(NULL AS BIGINT) AS Id,
            Q.DocumentReferenceId,
            CAST(NULL AS NVARCHAR(1)) AS CorrelationId,
            CAST(NULL AS NVARCHAR(1)) AS PresentedTokenHash,
            CAST(NULL AS NVARCHAR(1)) AS OutcomeCode,
            CAST(NULL AS BIT) AS ConsumesQuota,
            CAST(NULL AS BIGINT) AS DeniedByRuleId,
            CAST(NULL AS NVARCHAR(1)) AS DeniedByRuleName,
            CAST(NULL AS NVARCHAR(1)) AS IpAddress,
            CAST(NULL AS NVARCHAR(1)) AS UserAgent,
            CAST(NULL AS DATETIME2(3)) AS CreatedDate,
            CAST(NULL AS NVARCHAR(1)) AS CreatedBy,
            Q.QuotaAccessPolicyId,
            Q.QuotaAccessPolicyName,
            Q.QuotaRuleId,
            Q.QuotaRuleName,
            Q.QuotaWindowSeconds,
            Q.QuotaMaximumAccessCount,
            Q.QuotaIsConfigurationValid,
            Q.QuotaUsedAccessCount,
            CASE
                WHEN Q.QuotaUsedAccessCount IS NULL THEN CAST(NULL AS BIGINT)
                WHEN Q.QuotaUsedAccessCount >= Q.QuotaMaximumAccessCount THEN CAST(0 AS BIGINT)
                ELSE CAST(Q.QuotaMaximumAccessCount AS BIGINT) - Q.QuotaUsedAccessCount
            END AS QuotaRemainingAccessCount
        FROM RuleUsage AS Q
    )
    SELECT *
    FROM ResultRows
    ORDER BY
        RowType,
        CreatedDate DESC,
        Id DESC,
        CASE WHEN QuotaWindowSeconds IS NULL THEN 0 ELSE 1 END,
        QuotaWindowSeconds,
        QuotaRuleId;
END;
GO



