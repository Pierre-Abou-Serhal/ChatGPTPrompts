## CSharp/DocumentAccessAuditMapper.cs

```csharp
using System;
using System.Collections.Generic;
using System.Linq;

// Add the model namespace if this file lives in a separate namespace.
public static class DocumentAccessAuditMapper
{
    public static List<DocumentAccessAudit> ToModels(IEnumerable<DocumentAccessAuditDbRow> rows)
    {
        ArgumentNullException.ThrowIfNull(rows);

        return rows
            .GroupBy(row => row.Id)
            .OrderByDescending(group => group.First().CreatedDate)
            .ThenByDescending(group => group.Key)
            .Select(group =>
            {
                DocumentAccessAuditDbRow row = group.First();

                return new DocumentAccessAudit
                {
                    Id = row.Id,
                    DocumentReferenceId = row.DocumentReferenceId,
                    CorrelationId = row.CorrelationId,
                    PresentedTokenHash = row.PresentedTokenHash,
                    OutcomeCode = row.OutcomeCode,
                    ConsumesQuota = row.ConsumesQuota,
                    DeniedByRuleId = row.DeniedByRuleId,
                    DeniedByRuleName = row.DeniedByRuleName,
                    IpAddress = row.IpAddress,
                    UserAgent = row.UserAgent,
                    // Existing procedure uses GETDATE(), so preserve the
                    // source clock value; do not relabel it as UTC.
                    CreatedDate = row.CreatedDate,
                    CreatedBy = row.CreatedBy,
                    QuotaCalculationBasis = "CurrentPolicyRules",
                    RemainingScansByRule = group
                        .Where(rule => rule.QuotaRuleId.HasValue)
                        .GroupBy(rule => rule.QuotaRuleId!.Value)
                        .Select(rule => rule.First())
                        .OrderBy(rule => rule.QuotaWindowSeconds.HasValue ? 1 : 0)
                        .ThenBy(rule => rule.QuotaWindowSeconds)
                        .ThenBy(rule => rule.QuotaRuleId)
                        .Select(rule => new DocumentAccessRuleBalance
                        {
                            AccessPolicyId = rule.QuotaAccessPolicyId
                                ?? throw new InvalidOperationException("A quota rule has no policy ID."),
                            AccessPolicyName = rule.QuotaAccessPolicyName ?? string.Empty,
                            RuleId = rule.QuotaRuleId!.Value,
                            RuleName = rule.QuotaRuleName ?? string.Empty,
                            WindowSeconds = rule.QuotaWindowSeconds,
                            MaximumAccessCount = rule.QuotaMaximumAccessCount
                                ?? throw new InvalidOperationException("A quota rule has no maximum count."),
                            UsedAccessCount = rule.QuotaUsedAccessCount,
                            RemainingAccessCount = rule.QuotaRemainingAccessCount,
                            IsConfigurationValid = rule.QuotaIsConfigurationValid == true
                        }).ToList()
                };
            }).ToList();
    }
}
```


## Sql/usp_GetDocumentAccessAudit.sql

```sql
USE [Alterna_AccountStatementManagement];
GO
SET ANSI_NULLS ON;
GO
SET QUOTED_IDENTIFIER ON;
GO

ALTER PROCEDURE dbo.usp_GetDocumentAccessAudit
    @P__DocumentReferenceId BIGINT
AS
BEGIN
    SET NOCOUNT ON;

    /*
      Balances are reconstructed AFTER each recorded attempt, using the
      document's CURRENT policy and its CURRENT enabled rule definitions.
      They are not immutable historical rule snapshots or balances as of now.

      The current successful attempt is included through ConsumesQuota.
      A rejected attempt with ConsumesQuota = 0 does not increase usage.
      Id breaks ties for attempts recorded in the same DATETIME2(3) value.
    */
    ;WITH DocumentAudits AS
    (
        SELECT
            A.*,
            SUM(CONVERT(BIGINT, CASE WHEN A.ConsumesQuota = 1 THEN 1 ELSE 0 END))
                OVER
                (
                    PARTITION BY A.DocumentReferenceId
                    ORDER BY A.CreatedDate, A.Id
                    ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
                ) AS LifetimeUsedAccessCount
        FROM dbo.t_DocumentAccessAudit AS A
        WHERE A.DocumentReferenceId = @P__DocumentReferenceId
    )
    SELECT
        DAA.Id,
        DAA.DocumentReferenceId,
        DAA.CorrelationId,
        DAA.PresentedTokenHash,
        DAA.OutcomeCode,
        DAA.ConsumesQuota,
        DAA.DeniedByRuleId,
        CASE WHEN DAA.DeniedByRuleId IS NULL THEN NULL
             ELSE CONCAT(DeniedPolicy.PolicyName, N' : ', DeniedRule.RuleName)
        END AS DeniedByRuleName,
        DAA.IpAddress,
        DAA.UserAgent,
        DAA.CreatedDate,
        DAA.CreatedBy,

        R.AccessPolicyId AS QuotaAccessPolicyId,
        CurrentPolicy.PolicyName AS QuotaAccessPolicyName,
        R.Id AS QuotaRuleId,
        R.RuleName AS QuotaRuleName,
        R.WindowSeconds AS QuotaWindowSeconds,
        R.MaximumAccessCount AS QuotaMaximumAccessCount,
        CONVERT(BIT, Validity.IsConfigurationValid) AS QuotaIsConfigurationValid,
        Usage.UsedAccessCount AS QuotaUsedAccessCount,
        CASE
            WHEN Usage.UsedAccessCount IS NULL THEN CONVERT(BIGINT, NULL)
            WHEN Usage.UsedAccessCount >= R.MaximumAccessCount THEN CONVERT(BIGINT, 0)
            ELSE CONVERT(BIGINT, R.MaximumAccessCount) - Usage.UsedAccessCount
        END AS QuotaRemainingAccessCount
    FROM DocumentAudits AS DAA
    LEFT JOIN dbo.t_AccessPolicyRule AS DeniedRule
        ON DeniedRule.Id = DAA.DeniedByRuleId
    LEFT JOIN dbo.t_AccessPolicy AS DeniedPolicy
        ON DeniedPolicy.Id = DeniedRule.AccessPolicyId
    LEFT JOIN dbo.t_DocumentReference AS DR
        ON DR.Id = DAA.DocumentReferenceId
    LEFT JOIN dbo.t_AccessPolicy AS CurrentPolicy
        ON CurrentPolicy.Id = DR.AccessPolicyId
    LEFT JOIN dbo.t_AccessPolicyRule AS R
        ON R.AccessPolicyId = DR.AccessPolicyId
       AND R.IsEnabled = 1
    CROSS APPLY
    (
        VALUES
        (
            CASE
                WHEN R.Id IS NULL THEN NULL
                WHEN R.MaximumAccessCount > 0
                 AND (R.WindowSeconds IS NULL OR R.WindowSeconds > 0) THEN 1
                ELSE 0
            END
        )
    ) AS Validity(IsConfigurationValid)
    OUTER APPLY
    (
        SELECT COUNT_BIG(*) AS RollingUsedAccessCount
        FROM dbo.t_DocumentAccessAudit AS A
        WHERE Validity.IsConfigurationValid = 1
          AND R.WindowSeconds > 0
          AND A.DocumentReferenceId = DAA.DocumentReferenceId
          AND A.ConsumesQuota = 1
          -- Same exclusive lower boundary as usp_GetDocumentCuk.
          AND A.CreatedDate > DATEADD
          (
              SECOND,
              CASE WHEN R.WindowSeconds > 0 THEN -R.WindowSeconds ELSE NULL END,
              DAA.CreatedDate
          )
          AND
          (
              A.CreatedDate < DAA.CreatedDate
              OR (A.CreatedDate = DAA.CreatedDate AND A.Id <= DAA.Id)
          )
    ) AS RollingUsage
    CROSS APPLY
    (
        VALUES
        (
            CASE
                WHEN Validity.IsConfigurationValid = 1 THEN
                    CASE WHEN R.WindowSeconds IS NULL THEN DAA.LifetimeUsedAccessCount
                         ELSE RollingUsage.RollingUsedAccessCount END
                ELSE CONVERT(BIGINT, NULL)
            END
        )
    ) AS Usage(UsedAccessCount)
    ORDER BY
        DAA.CreatedDate DESC,
        DAA.Id DESC,
        CASE WHEN R.WindowSeconds IS NULL THEN 0 ELSE 1 END,
        R.WindowSeconds,
        R.Id;
END;
GO
```
