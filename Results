ALTER PROCEDURE [dbo].[usp_Get_Leap_Customers_By_Account_Id_List]
    @P__Account_Id_List NVARCHAR(MAX)
AS
BEGIN
    SET NOCOUNT ON;

    ;WITH IdList AS
    (
        SELECT DISTINCT
            LTRIM(RTRIM([value])) AS AccountId
        FROM STRING_SPLIT(@P__Account_Id_List, ',')
        WHERE LTRIM(RTRIM([value])) <> ''
    ),
    ParsedAccounts AS
    (
        SELECT
            AccountId AS InputedId,
            -- Equivalent to C# AccountId.Substring(2, 7).
            TRY_CONVERT(INT, SUBSTRING(AccountId, 3, 7)) AS CustomerId,
            RIGHT(AccountId, 3) AS Currency
        FROM IdList
    ),
    RelatedCustomers AS
    (
        SELECT DISTINCT
            INPUT.InputedId,
            -- Return the related customer's own ID for the account lookup.
            RELATED_CUSTOMER.Id AS RelCustomer,
            INPUT.Currency
        FROM ParsedAccounts AS INPUT
        INNER JOIN [dbo].[tblCustomer] AS RELATED_CUSTOMER
            ON TRY_CONVERT(INT, RELATED_CUSTOMER.RelCustomer) = INPUT.CustomerId
        WHERE RELATED_CUSTOMER.RelationCode = 9
          AND RELATED_CUSTOMER.CompanyBook = 'LB0010307'
    ),
    RankedData AS
    (
        SELECT
            RELATED.InputedId,
            RELATED.RelCustomer,
            RELATED.Currency,
            ACCOUNT.Id AS T24AccountId,
            ARRANGEMENT.Product AS ProductCode,
            ARRANGEMENT.ProdEffDate,
            ROW_NUMBER() OVER
            (
                PARTITION BY RELATED.RelCustomer
                ORDER BY
                    ARRANGEMENT.ProdEffDate DESC,
                    ACCOUNT.Id,
                    RELATED.InputedId,
                    ARRANGEMENT.Product
            ) AS rn
        FROM RelatedCustomers AS RELATED
        INNER JOIN [Alterna.BRef].[dbo].[t_AccountV2] AS ACCOUNT
            ON TRY_CONVERT(INT, ACCOUNT.Customer) = RELATED.RelCustomer
           AND RIGHT(RTRIM(ACCOUNT.Id), 3) = RELATED.Currency
        LEFT JOIN [dbo].[t_Arrangement_T24] AS ARRANGEMENT
            ON ARRANGEMENT.Id = ACCOUNT.ArrangementId
        WHERE ARRANGEMENT.ProductStatus = 'CURRENT'
          AND ARRANGEMENT.ArrStatus IN ('AUTH', 'RESTORE-AUTH', 'CURRENT')
    )
    SELECT
        InputedId,
        T24AccountId,
        ProductCode,
        ProdEffDate,
        RelCustomer,
        Currency
    FROM RankedData
    WHERE rn = 1
    ORDER BY ProdEffDate DESC;
END;

