CREATE PROCEDURE [dbo].[sp_List_File_Receipts]
    @P__InstitutionId BIGINT,
    @P__State NVARCHAR(128),
    @P__Pattern NVARCHAR(4000),
    @P__Skip INT,
    @P__Take INT
AS
BEGIN
    SET NOCOUNT ON;

    SELECT r.Id,
           r.OriginalFilename,
           ri.Code AS IntakeInstitution,
           ei.Code AS EffectiveInstitution,
           r.ChannelCode AS Channel,
           r.CreatedDate AS ReceivedDate,
           r.StatusCode AS ImportState,
           r.LocationStateCode AS LocationState,
           r.ErrorType,
           r.DuplicateOf,
           b.Id AS BatchId,
           b.State AS BatchState,
           r.DetectedDefinition,
           r.SourceBytes,
           b.OutputCode,
           (
               SELECT COUNT(*) FROM dbo.t_Transfers t WHERE t.BatchId = b.Id
           ) AS TransferCount,
           (
               SELECT COUNT(*)
               FROM dbo.t_Transfers t
               WHERE t.BatchId = b.Id
                     AND t.Decision = 'Pending'
           ) AS PendingCount
    FROM dbo.t_File_Receipts r
        JOIN dbo.t_Institutions ri
            ON ri.Id = r.ProposedInstitutionId
        JOIN dbo.t_Institutions ei
            ON ei.Id = r.EffectiveInstitutionId
        LEFT JOIN dbo.t_Payment_Batches b
            ON b.ReceiptId = r.Id
    WHERE (
              @P__InstitutionId IS NULL
              OR r.EffectiveInstitutionId = @P__InstitutionId
          )
          AND (
                  @P__State IS NULL
                  OR r.StatusCode = @P__State
                  OR b.State = @P__State
              )
          AND (
                  @P__Pattern IS NULL
                  OR r.OriginalFilename LIKE @P__Pattern
                  OR b.OriginalMessageId LIKE @P__Pattern
              )
    ORDER BY r.CreatedDate DESC,
             r.Id DESC OFFSET @P__Skip ROWS FETCH NEXT @P__Take ROWS ONLY;
END;
GO

