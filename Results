
    
  
private void UpdateSalDomDatabase(
    List<SalDomClient> salDomClients,
    SendEmailAttachmentForValidationRequest request,
    Model.File fileConfig,
    ExchangeApiAttachmentInfo attachmentInfo)
{
    // Step 0: Query Dictionary
    List<Dictionary> dictionaryList = QueryDictionary(salDomClients.Select(i => i.AlternativeAccount).ToList(), fileConfig.Id);

    // Step 1: Get All Alternative Accounts That are in Dictionary And salDomClients
    List<Dictionary> t24AccountsForMatchingAltAccsInBoth = dictionaryList
        .Where(i => salDomClients.Any(y => y.AlternativeAccount.Equals(i.AlternativeAccountId)))
        .ToList();

    var dictionaryMappingsByAlternativeId = t24AccountsForMatchingAltAccsInBoth
        .ToLookup(mapping => mapping.AlternativeAccountId);

    // Step 2: Remove alternativeAccountsInBoth From salDomClients
    List<SalDomClient> salDomClientDivided = salDomClients.Where(i => !t24AccountsForMatchingAltAccsInBoth.Any(y => y.AlternativeAccountId.Equals(i.AlternativeAccount))).ToList();

    // Step 3: Group Received Accounts into T24 Format + T24 Accounts Found In Dictionary
    List<String> accountsWithT24Formats = salDomClientDivided.Where(i => Utilities.ValidateT24AccountNumber(i.AlternativeAccount)).Select(i => i.AlternativeAccount).ToList();

    // Step 4: Group Received Accounts into Non T24 Format
    List<String> alternativeIdsToLookup = salDomClientDivided.Where(i => !Utilities.ValidateT24AccountNumber(i.AlternativeAccount)).Select(i => i.AlternativeAccount).ToList();

    // Get Current Product Code For The T24 Format Accounts
    GetCustomerByAccountIdListReq? getCustomerByAccountIdListReq;
    GetCustomerByAccountIdListRes? getCustomerByAccountIdListRes = null;

    if (accountsWithT24Formats.Count > 0)
    {
        getCustomerByAccountIdListReq = new()
        {
            BaseReq = new()
            {
                CorrelationId = request.BaseReq.CorrelationId,
                UserName = request.BaseReq.UserData.UserName
            },
            ProductCodesList = fileConfig.FileProducts!.Select(fp => fp.Code).ToList(),
            AccountIdList = String.Join(',', accountsWithT24Formats)
        };

        getCustomerByAccountIdListRes =
            Post<GetCustomerByAccountIdListRes>(
                getCustomerByAccountIdListReq,
                $"{_globalSettings.DataGateWayUrl}/api/Customer/GetCustomerByAccountIdList");
    }

    if (getCustomerByAccountIdListRes is not null && Int32.Parse(getCustomerByAccountIdListRes.WebResp.ReturnCode.Code) != 200)
    {
        throw new Exception(getCustomerByAccountIdListRes.WebResp.ReturnCode.Message);
    }

    IEnumerable<CustomerInfo> LookupDictionaryAccounts(List<String> accountIds)
    {
        GetCustomerByAccountIdListReq lookupRequest = new()
        {
            BaseReq = new()
            {
                CorrelationId = request.BaseReq.CorrelationId,
                UserName = request.BaseReq.UserData.UserName
            },
            ProductCodesList = fileConfig.FileProducts!.Select(fp => fp.Code).ToList(),
            AccountIdList = String.Join(',', accountIds)
        };

        GetCustomerByAccountIdListRes lookupResponse = Post<GetCustomerByAccountIdListRes>(
            lookupRequest,
            $"{_globalSettings.DataGateWayUrl}/api/Customer/GetCustomerByAccountIdList")
            ?? throw new Exception("No response from Data Gateway for the dictionary account lookup.");

        if (Int32.Parse(lookupResponse.WebResp.ReturnCode.Code) != 200)
        {
            throw new Exception(lookupResponse.WebResp.ReturnCode.Message);
        }

        return lookupResponse.CustomersList ?? [];
    }

    List<String> dictionaryAccountIds = t24AccountsForMatchingAltAccsInBoth
        .Select(mapping => mapping.T24AccountId)
        .Where(accountId => !String.IsNullOrWhiteSpace(accountId))
        .Distinct()
        .ToList();

    List<CustomerInfo> dictionaryCustomers = [];
    if (dictionaryAccountIds.Count > 0)
    {
        dictionaryCustomers.AddRange(LookupDictionaryAccounts(dictionaryAccountIds));

        // Resend the same dictionary account IDs so Gateway can resolve LEAP replacements.
        List<String> missingDictionaryAccountIds = dictionaryAccountIds
            .Except(dictionaryCustomers.Select(customer => customer.InputedId))
            .ToList();

