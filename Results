/*
    Alterna Payment Management database installation
    SQL Server 2016

    Create the empty Alterna_PaymentManagement database first. Run this entire
    file in one SSMS query window and check the Messages tab for errors.

    Application tables use BIGINT identities. t_Lookup uses an INT identity.
    Identity insert procedures return the generated Id in a single-row result.
    The transfer list type is dbo.tvp_Transfer_Id_List with a BIGINT Id column.
    Workflow dates use DATETIME with GETDATE() for server-local timestamps.
    Procedure parameters use the @P__PascalCase convention.

    The script seeds workflow lookups. Configure institutions, ISO message
    definitions, institution response mappings, and routing thresholds separately.
*/
USE [Alterna_PaymentManagement];
GO

-- Skip the installation batches if the target database could not be selected.
IF DB_NAME() <> N'Alterna_PaymentManagement'
BEGIN
    PRINT N'Installation skipped. Select the Alterna_PaymentManagement database.';
    SET NOEXEC ON;
END;
GO

SET ANSI_NULLS ON;
SET QUOTED_IDENTIFIER ON;
SET ANSI_PADDING ON;
SET ANSI_WARNINGS ON;
SET ARITHABORT ON;
SET CONCAT_NULL_YIELDS_NULL ON;
SET NUMERIC_ROUNDABORT OFF;
GO

-- Workflow lookup table and seed values.
CREATE TABLE dbo.t_Lookup
(
    Id INT IDENTITY(1, 1) NOT NULL,
    TableName NVARCHAR(50) NOT NULL,
    Code NVARCHAR(50) NOT NULL,
    Description NVARCHAR(MAX) NOT NULL,
    IsActive BIT NOT NULL,
    CreatedBy NVARCHAR(255) NOT NULL
        CONSTRAINT DF_t_Lookup_CreatedBy
        DEFAULT (N'AlternaSystem'),
    CreatedDate DATETIME NOT NULL
        CONSTRAINT DF_t_Lookup_CreatedDate
        DEFAULT (GETDATE()),
    LastModifiedBy NVARCHAR(255) NOT NULL
        CONSTRAINT DF_t_Lookup_LastModifiedBy
        DEFAULT (N'AlternaSystem'),
    LastModifiedDate DATETIME NOT NULL
        CONSTRAINT DF_t_Lookup_LastModifiedDate
        DEFAULT (GETDATE()),
    CONSTRAINT PK_t_Lookup
        PRIMARY KEY CLUSTERED (Id),
    CONSTRAINT UQ_t_Lookup_TableName_Code
        UNIQUE NONCLUSTERED
        (
            TableName,
            Code
        )
) ON [PRIMARY] TEXTIMAGE_ON [PRIMARY];
GO

INSERT dbo.t_Lookup
(
    TableName,
    Code,
    Description,
    IsActive
)
SELECT seed.TableName,
       seed.Code,
       seed.Description,
       1
FROM
(
    VALUES
        (N't_Batch_Categories.Category', N'LOCAL', N'Local'),
        (N't_Batch_Categories.Category', N'ACH', N'ACH / BDL Clear'),
        (N't_Batch_Categories.Category', N'RTGS', N'RTGS'),
        (N't_Batch_Categories.Category', N'SWIFT', N'SWIFT'),
        (N't_Batch_Categories.Category', N'INVALID', N'Invalid'),
        (N't_File_Receipts.ChannelCode', N'Poll', N'Folder polling'),
        (N't_File_Receipts.ChannelCode', N'Upload', N'Manual upload'),
        (N't_File_Receipts.StatusCode', N'Received', N'Received'),
        (N't_File_Receipts.StatusCode', N'Claimed', N'Claimed'),
        (N't_File_Receipts.StatusCode', N'Validating', N'Validating'),
        (N't_File_Receipts.StatusCode', N'Imported', N'Imported'),
        (N't_File_Receipts.StatusCode', N'ImportFailed', N'Import failed'),
        (N't_File_Receipts.StatusCode', N'Duplicate', N'Duplicate'),
        (N't_File_Receipts.LocationStateCode', N'Inbound', N'Inbound'),
        (N't_File_Receipts.LocationStateCode', N'Claimed', N'Claimed'),
        (N't_File_Receipts.LocationStateCode', N'ArchivePending', N'Archive move pending'),
        (N't_File_Receipts.LocationStateCode', N'Archived', N'Archived'),
        (N't_File_Receipts.LocationStateCode', N'ErrorMovePending', N'Error move pending'),
        (N't_File_Receipts.LocationStateCode', N'Error', N'Moved to ERROR'),
        (N't_Iso_Definitions.Family', N'pain.001', N'Customer credit transfer initiation'),
        (N't_Iso_Definitions.Family', N'pain.002', N'Customer payment status report'),
        (N't_Outgoing_Documents.Kind', N'Pain002', N'pain.002 payment status report'),
        (N't_Outgoing_Documents.Kind', N'ImportErrorJson', N'Import error report (JSON)'),
        (N't_Outgoing_Documents.PublicationState', N'Pending', N'Pending publication'),
        (N't_Outgoing_Documents.PublicationState', N'Publishing', N'Publishing'),
        (N't_Outgoing_Documents.PublicationState', N'PublishedToOut', N'Published to OUT'),
        (N't_Outgoing_Documents.PublicationState', N'Failed', N'Publication failed'),
        (N't_Outgoing_Documents.PublicationState', N'SupersededUnpublished', N'Superseded before publication'),
        (N't_Payment_Batches.State', N'Editable', N'Editable'),
        (N't_Payment_Batches.State', N'Finalizing', N'Finalizing'),
        (N't_Payment_Batches.State', N'Finalized', N'Finalized'),
        (N't_Transfers.Decision', N'Pending', N'Pending decision'),
        (N't_Transfers.Decision', N'Approved', N'Approved'),
        (N't_Transfers.Decision', N'Rejected', N'Rejected'),
        (N't_Transfers.DecisionSource', N'System', N'System decision'),
        (N't_Transfers.DecisionSource', N'Operator', N'Operator decision')
) AS seed (TableName, Code, Description)
WHERE NOT EXISTS
(
    SELECT 1
    FROM dbo.t_Lookup AS existing WITH (UPDLOCK, HOLDLOCK)
    WHERE existing.TableName = seed.TableName
          AND existing.Code = seed.Code
);
GO

