CREATE PROCEDURE [dbo].[usp_GetDocumentAccessAudit]
    @P__DocumentReferenceId BIGINT
AS
BEGIN
    SET NOCOUNT ON;

	SELECT 
		DAA.[Id],
		DAA.[DocumentReferenceId],
		DAA.[CorrelationId],
		DAA.[PresentedTokenHash],
		DAA.[OutcomeCode],
		DAA.[ConsumesQuota],
		DAA.[DeniedByRuleId],
		CONCAT(AP.PolicyName, ' : ', APR.[RuleName]) AS DeniedByRuleName,
		DAA.[IpAddress],
		DAA.[UserAgent],
		DAA.[CreatedDate],
		DAA.[CreatedBy]
	FROM [dbo].[t_DocumentAccessAudit] AS DAA
	JOIN t_AccessPolicy AS AP ON DAA.DeniedByRuleId = AP.Id
	JOIN t_AccessPolicyRule AS APR ON APR.AccessPolicyId = AP.Id
	WHERE
		DAA.[DocumentReferenceId] = @P__DocumentReferenceId
	ORDER BY CreatedDate DESC
END

